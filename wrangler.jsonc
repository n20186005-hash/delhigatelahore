{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "delhi-gate-lahore",
  "compatibility_date": "2026-09-17",
  // Static site: no Worker script entry point (`main`) is needed, so wrangler
  // only serves the built assets from ./dist.
  "assets": {
    "directory": "./dist"
  }
}
