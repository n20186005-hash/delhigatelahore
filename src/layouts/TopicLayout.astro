---
import '../styles/global.css';
import * as attraction from '../data/attraction';
import { UI, CHECK_NOTE, type Locale, type Topic } from '../data/topic-types';
import { topicPath, topicAlternates, relatedTopics } from '../data/topics';
import { getNearbyProfile, urNearby } from '../data/nearby-profiles';

export interface Props {
  locale: Locale;
  topic: Topic;
}

const { locale, topic } = Astro.props;
const ui = UI[locale];
const content = topic[locale];
const site = Astro.site ?? new URL(`https://${attraction.DOMAIN_NAME}`);
const canonical = new URL(topicPath(locale, topic.slug), site).toString();
const otherLocale: Locale = locale === 'en' ? 'ur' : 'en';
const otherUrl = topicPath(otherLocale, topic.slug);
const homeUrl = new URL(ui.homeUrl, site).toString();
const ogImage = new URL('/images/og-cover.png', site).toString();
const alternates = topicAlternates(site, topic.slug);
const related = relatedTopics(topic);
const groupLabel = ui.groupLabels[topic.group];
const nearby = getNearbyProfile(topic.slug);
const nearbyUr = urNearby[topic.slug];
const local = (en: string, ur: string) => locale === 'en' ? en : ur;
const nearbyMap = nearby ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nearby.map)}` : '';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: content.title,
  description: content.description,
  inLanguage: ui.inLanguage,
  isPartOf: {
    '@type': 'WebSite',
    name: ui.siteName,
    url: homeUrl
  },
  about: {
    '@type': 'TouristAttraction',
    '@id': `https://${attraction.DOMAIN_NAME}/#attraction`
  },
  breadcrumb: { '@id': `${canonical}#breadcrumb` }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.home, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: content.h1, item: canonical }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: ui.inLanguage,
  mainEntity: content.faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<!doctype html>
<html lang={ui.htmlLang} dir={ui.dir}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{content.title}</title>
<meta name="description" content={content.description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta name="geo.region" content={`${attraction.COUNTRY_CODE_2LETTER}-PB`} />
<meta name="geo.placename" content={attraction.CITY_NAME} />
<meta name="geo.position" content={`${attraction.LATITUDE};${attraction.LONGITUDE}`} />

<meta property="og:site_name" content={ui.siteName} />
<meta property="og:locale" content={ui.ogLocale} />
<meta property="og:title" content={content.title} />
<meta property="og:description" content={content.description} />
<meta property="og:type" content="article" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={content.title} />
<meta name="twitter:description" content={content.description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#5e241e" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
</head>
<body>
  <header class="tile-border topic-hero">
    <div class="container">
      <nav class="topic-nav">
        <a class="brand" href={ui.homeUrl}><img src="/icons/logo.svg" alt={attraction.ATTRACTION_SHORT_NAME} />{attraction.ATTRACTION_SHORT_NAME}</a>
        <a href={ui.homeUrl}>{ui.home}</a>
        <a href={`${ui.homeUrl}#guides`}>{ui.guides}</a>
        <a class="lang-switch" href={otherUrl} hreflang={UI[otherLocale].htmlLang} lang={UI[otherLocale].htmlLang} dir={UI[otherLocale].dir}>{ui.langSwitchLabel}</a>
      </nav>
      <div class="section-kicker">{content.kicker} · {groupLabel}</div>
      <h1>{content.h1}</h1>
      <p class="lede">{content.lead}</p>
      {nearby && <div class="nearby-hero-facts">
        <span>{local(nearby.type, 'تاریخی مقام · لاہور اندرون شہر')}</span>
        <span>{local('Hours: confirm before visiting', 'اوقات: جانے سے پہلے تصدیق کریں')}</span>
        <a href={nearbyMap} target="_blank" rel="noopener noreferrer">{local('View location ↗', 'نقشے پر مقام دیکھیں ↗')}</a>
      </div>}
    </div>
  </header>

  <nav class="breadcrumb" aria-label={ui.breadcrumbAria}>
    <div class="container breadcrumb-inner">
      <ol>
        <li><a href={ui.homeUrl}>{ui.home}</a></li>
        <li aria-current="page">{content.h1}</li>
      </ol>
    </div>
  </nav>

  <main>
    {nearby && <section class="topic-section nearby-expanded">
      <div class="container topic-body">
        <article class="card nearby-intro">
          <div class="section-kicker">{local('Explore the landmark', 'اس تاریخی مقام کو دریافت کریں')}</div>
          <h2>{local(`Discover ${nearby.name}`, content.h1)}</h2>
          <p>{locale === 'en' ? nearby.experience : content.lead}</p>
        </article>
        <div class="grid grid-2">
          <article class="card"><h2>{local('Visit tips', 'دورے کی تجاویز')}</h2><p>{locale === 'en' ? nearby.guidance : 'مقامی آمدورفت، مذہبی اوقات اور اجازت یافتہ حصوں کی پابندی کریں۔ لوگوں کی تصویر لینے سے پہلے اجازت طلب کریں۔'}</p></article>
          <article class="card"><h2>{local('Highlights', 'نمایاں خصوصیات')}</h2><ul class="src-list">{(locale === 'en' ? nearby.highlights : nearbyUr.highlights).map(x => <li>{x}</li>)}</ul></article>
        </div>
        <article class="card"><h2>{local('About the landmark', 'تاریخی مقام کے بارے میں')}</h2><p>{locale === 'en' ? nearby.story : nearbyUr.theme}</p></article>
        <article class="card"><h2>{local('Basic information', 'بنیادی معلومات')}</h2>
          <dl class="nearby-facts">
            <div><dt>{local('Name', 'نام')}</dt><dd>{locale === 'en' ? nearby.name : content.h1}</dd></div>
            <div><dt>{local('Type', 'نوعیت')}</dt><dd>{local(nearby.type, 'تاریخی مقام / مقامی ثقافتی ورثہ')}</dd></div>
            <div><dt>{local('Location', 'مقام')}</dt><dd>{local(nearby.setting, 'اندرون لاہور، پنجاب، پاکستان')}</dd></div>
            <div><dt>{local('Map', 'نقشہ')}</dt><dd><a href={nearbyMap} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></dd></div>
          </dl>
        </article>
        <div class="grid grid-2">
          <article class="card"><h2>{local('Opening hours', 'کھلنے کے اوقات')}</h2><p>{local(nearby.access, 'اوقات اور رسائی میں تبدیلی ممکن ہے؛ دورے کے دن مقام کی انتظامیہ سے تصدیق کریں۔')}</p></article>
          <article class="card"><h2>{local('Ticket prices', 'ٹکٹ کی قیمت')}</h2><p>{local(nearby.fee, 'موجودہ داخلہ فیس کی تصدیق نہیں ہوئی؛ مقام یا منتظم سے معلوم کریں۔')}</p></article>
        </div>
        <article class="card"><h2>{local('How to get here', 'یہاں کیسے پہنچیں')}</h2><p>{local(nearby.transport, 'دہلی گیٹ سے موجودہ نقشے پر راستہ چیک کریں؛ پرانے شہر میں گلیاں تنگ اور مصروف ہو سکتی ہیں۔')}</p><p><a href={nearbyMap} target="_blank" rel="noopener noreferrer">{local('Open the landmark map ↗', 'مقام کا نقشہ کھولیں ↗')}</a></p></article>
        <article class="card"><h2>{local('Discover its character', 'تاریخ، تعمیر اور ثقافت')}</h2>
          <div class="nearby-discovery">
            <div><h3>{local('History', 'تاریخ')}</h3><p>{locale === 'en' ? nearby.story : nearbyUr.theme}</p></div>
            <div><h3>{local('Architecture and setting', 'تعمیر اور ماحول')}</h3><p>{locale === 'en' ? nearby.architecture : content["sections"][0]?.p?.[0] ?? nearbyUr.theme}</p></div>
            <div><h3>{local('Culture', 'ثقافت')}</h3><p>{locale === 'en' ? nearby.culture : content.sections[1]?.p?.[0] ?? nearbyUr.theme}</p></div>
            <div><h3>{local('Core experience', 'اہم تجربہ')}</h3><p>{locale === 'en' ? nearby.experience : content.lead}</p></div>
          </div>
        </article>
        <article class="card"><h2>{local('Recommended walking route', 'تجویز کردہ پیدل راستہ')}</h2><ol class="nearby-steps">{(locale === 'en' ? nearby.route : nearbyUr.route).map(x => <li>{x}</li>)}</ol></article>
        <article class="card"><h2>{local('Visitor guidelines', 'زائرین کے لیے ہدایات')}</h2><p>{local(nearby.guidance, 'مقامی ہدایات اور مذہبی روایات کا احترام کریں۔ مصروف گلیوں میں راستہ کھلا رکھیں اور لوگوں کی تصویر اجازت کے بغیر نہ لیں۔')}</p></article>
        <article class="card"><h2>{local('Photo spots', 'تصاویر کے لیے مقامات')}</h2><ol class="nearby-steps">{(locale === 'en' ? nearby.photos : nearbyUr.photos).map(x => <li>{x}</li>)}</ol></article>
        <article class="card"><h2>{local('Where to stay', 'قیام کی تجاویز')}</h2><p>{local(nearby.stay, 'ایسی رہائش منتخب کریں جہاں سے پرانے شہر کے داخلی راستوں تک قابل اعتماد آمدورفت ہو۔ بکنگ سے پہلے حالیہ جائزے اور سفر کے انتظامات دیکھیں۔')}</p></article>
        <article class="card"><h2>{local('Visitor reviews', 'زائرین کے تاثرات')}</h2><p>{local('For current visitor feedback, photographs and access reports, consult the landmark’s Google Maps listing. No unverified individual reviews are reproduced here.', 'تازہ تاثرات، تصاویر اور رسائی کی معلومات کے لیے مقام کی گوگل میپس فہرست دیکھیں۔ یہاں غیر مصدقہ ذاتی تبصرے نقل نہیں کیے گئے۔')}</p><a href={nearbyMap} target="_blank" rel="noopener noreferrer">{local('See visitor feedback ↗', 'زائرین کے تاثرات دیکھیں ↗')}</a></article>
        <article class="card"><h2>{local('Address and navigation', 'پتا اور راستہ')}</h2><p>{local(nearby.setting, 'اندرون لاہور، پنجاب، پاکستان')}</p><a class="btn" href={nearbyMap} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></article>
        <h2 class="nearby-existing-heading">{local('Additional original guide details', 'اصل رہنما صفحے کی مزید معلومات')}</h2>
      </div>
    </section>}
    <section class="topic-section">
      <div class="container topic-body">
        {content.sections.map((section) => (
          <article class="card">
            <h2>{section.h}</h2>
            {section.p?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="src-list">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </article>
        ))}

        <article class="card topic-verification">
          <h2>{ui.sourcesTitle}</h2>
          <p class="credit">{CHECK_NOTE[locale]}</p>
          <p class="map-links">
            <a class="btn" href={attraction.MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">{ui.mapLabel} ↗</a>
            <a class="btn ghost" href={attraction.MAPS_DIRECTIONS_URL} target="_blank" rel="noopener noreferrer">{attraction.ATTRACTION_SHORT_NAME} ↗</a>
          </p>
          <p class="credit">{ui.mapNote}</p>
          <ul class="src-list">
            <li><a href={attraction.GOVT_TOURISM_URL}>Walled City of Lahore Authority — Gates</a></li>
            <li><a href="https://doam.gov.pk/public/sites/6449">Department of Archaeology and Museums — Delhi Gate</a></li>
            <li><a href={attraction.WIKIPEDIA_URL}>Wikipedia — Delhi Gate, Lahore</a></li>
            <li><a href={attraction.MET_OFFICE_URL}>Pakistan Meteorological Department</a></li>
          </ul>
        </article>
      </div>
    </section>

    <section class="faq topic-section" id="faq">
      <div class="container">
        <div class="section-kicker">FAQ</div>
        <h2>{ui.faqTitle}</h2>
        {content.faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="topic-section" id="related">
      <div class="container">
        <div class="section-kicker">{groupLabel}</div>
        <h2>{ui.relatedTitle}</h2>
        <div class="grid grid-3">
          {related.map((item) => (
            <a class="card topic-card" href={topicPath(locale, item.slug)}>
              <strong>{item[locale].h1}</strong>
              <span>{item[locale].description}</span>
            </a>
          ))}
        </div>
        <p class="map-links"><a class="btn ghost" href={`${ui.homeUrl}#guides`}>{ui.backHome}</a></p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p class="topic-footer-links">
        <a href={ui.homeUrl}>{attraction.ATTRACTION_SHORT_NAME}</a>
        <a href={`${ui.homeUrl}#guides`}>{ui.guides}</a>
        {ui.legalLinks.map((link) => <a href={link.url}>{link.label}</a>)}
        <a href={otherUrl} hreflang={UI[otherLocale].htmlLang}>{ui.langSwitchLabel}</a>
      </p>
      <p class="credit">{ui.independent}</p>
    </div>
  </footer>
</body>
</html>
