---
import '../styles/global.css';

// ---------------------------------------------------------------------------
// Single-attraction SEO entity bindings — change only the values below
// ---------------------------------------------------------------------------
const DOMAIN_NAME = 'delhigatelahore.com';
const ATTRACTION_FULL_NAME = 'Delhi Gate, Lahore';
const ATTRACTION_SHORT_NAME = 'Delhi Gate';
const CITY_NAME = 'Lahore';
const STATE_PROVINCE = 'Punjab';
const COUNTRY_NAME = 'Pakistan';
const COUNTRY_CODE_2LETTER = 'PK';
const POSTAL_CODE = '54000';
const LATITUDE = 31.5821649;
const LONGITUDE = 74.3264164;
const MAPS_SHARE_URL = 'https://maps.app.goo.gl/Q8yoAtkexN7HjBCu8';
const MAPS_EMBED_SRC = 'https://www.google.com/maps?q=31.5821649,74.3264164&hl=en&z=17&output=embed';
const MAPS_DIRECTIONS_URL = 'https://www.google.com/maps?q=31.5821649,74.3264164';
const NEARBY_LANDMARK_1 = 'Wazir Khan Mosque';
const NEARBY_LANDMARK_2 = 'Shahi Hammam';
const GOVT_TOURISM_URL = 'https://www.wcla.pk/';
const GOVT_TOURISM_URL_ALT = 'https://tourism.gov.pk/';
const WIKIPEDIA_URL = 'https://en.wikipedia.org/wiki/Delhi_Gate,_Lahore';
const WIKIMEDIA_CATEGORY_URL = 'https://commons.wikimedia.org/wiki/Category:Delhi_Gate_(Lahore)';
const MET_OFFICE_URL = 'https://www.pmd.gov.pk/';

// Rating / review numbers are shown on the page only and are intentionally
// kept out of every JSON-LD block (see "reviews" section near the map).
const RATING_VALUE = '4.6';
const RATING_COUNT = '21,997';
const RATING_MAX = '5';
const REVIEW_CATEGORY_EN = 'Historical landmark';
const REVIEW_CATEGORY_UR = 'تاریخی یادگار';
const REVIEW_SYNC_UR = 'ستمبر 2026ء';
const REVIEW_SYNC_EN = 'September 2026';

const site = Astro.site ?? new URL(`https://${DOMAIN_NAME}`);
const canonical = new URL('/', site).toString();
const ogImage = new URL('/images/og-cover.png', site).toString();
const ogImageAlt = `${ATTRACTION_FULL_NAME} — ${CITY_NAME}, ${COUNTRY_NAME}`;
const heroImageAbsolute =
  'https://upload.wikimedia.org/wikipedia/commons/1/1b/Delhi_Gate%2C_Lahore.jpg';

// ---------------------------------------------------------------------------
// Weather & air quality
// Data is requested from inside this component (server side) while the page is
// rendered, so visitors never see request details — only the plain numbers.
// The static page is then refreshed in the visitor's browser (see #wx script).
// ---------------------------------------------------------------------------
const WEATHER_QUERY =
  `latitude=${LATITUDE}&longitude=${LONGITUDE}` +
  '&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m' +
  '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,uv_index_max,wind_speed_10m_max' +
  '&forecast_days=7&timezone=Asia%2FKarachi';
const WEATHER_API = `https://api.open-meteo.com/v1/forecast?${WEATHER_QUERY}`;
const WEATHER_AIR_API =
  `https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${LATITUDE}&longitude=${LONGITUDE}` +
  '&current=us_aqi,european_aqi,pm2_5,pm10&timezone=Asia%2FKarachi';

// WMO weather codes → [Urdu description, glyph]
const WMO_CODES = {
  0: ['صاف آسمان', '☀️'],
  1: ['عموماً صاف', '🌤️'],
  2: ['جزوی بادل', '⛅'],
  3: ['ابراہ', '☁️'],
  45: ['دھند', '🌫️'],
  48: ['جمی ہوئی دھند', '🌫️'],
  51: ['ہلکی بوندا باندی', '🌦️'],
  53: ['درمیانی بوندا باندی', '🌦️'],
  55: ['گہری بوندا باندی', '🌧️'],
  56: ['ہلکی برفانی بوندا باندی', '🌧️'],
  57: ['گہری برفانی بوندا باندی', '🌧️'],
  61: ['ہلکی بارش', '🌧️'],
  63: ['درمیانی بارش', '🌧️'],
  65: ['تیز بارش', '🌧️'],
  66: ['ہلکی برفانی بارش', '🌨️'],
  67: ['تیز برفانی بارش', '🌨️'],
  71: ['ہلکی برفباری', '🌨️'],
  73: ['درمیانی برفباری', '🌨️'],
  75: ['شدید برفباری', '❄️'],
  77: ['برف کے دانے', '🌨️'],
  80: ['ہلکی جھڑی', '🌦️'],
  81: ['درمیانی جھڑی', '🌧️'],
  82: ['تیز جھڑی', '⛈️'],
  85: ['ہلکی برفانی جھڑی', '🌨️'],
  86: ['شدید برفانی جھڑی', '❄️'],
  95: ['گرج چمک کے ساتھ بارش', '⛈️'],
  96: ['گرج چمک اور اولے', '⛈️'],
  99: ['شدید گرج چمک اور اولے', '⛈️']
};
const WMO_FALLBACK = ['موسمی معلومات دستیاب نہیں', '🌡️'];
const WEEKDAYS = ['اتوار', 'پیر', 'منگل', 'بدھ', 'جمعرات', 'جمعہ', 'ہفتہ'];
const MONTHS = ['جنوری', 'فروری', 'مارچ', 'اپریل', 'مئی', 'جون', 'جولائی', 'اگست', 'ستمبر', 'اکتوبر', 'نومبر', 'دسمبر'];
const AQI_LEVELS: Array<[number, string, string]> = [
  [50, 'اچھا', 'good'],
  [100, 'درمیانہ', 'moderate'],
  [150, 'حساس افراد کے لیے غیر صحت بخش', 'sensitive'],
  [200, 'غیر صحت بخش', 'unhealthy'],
  [300, 'بہت غیر صحت بخش', 'very-unhealthy'],
  [Infinity, 'خطرناک', 'hazardous']
];
const WET_CODES = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82, 85, 86, 95, 96, 99];

type WeatherDay = {
  date: string;
  label: string;
  code: number | null;
  max: number | null;
  min: number | null;
  rainChance: number | null;
  rainSum: number | null;
  uv: number | null;
};
type WeatherData = {
  temperature: number | null;
  apparent: number | null;
  humidity: number | null;
  wind: number | null;
  precipitation: number | null;
  code: number | null;
  observedAt: string | null;
  days: WeatherDay[];
};
type AirQualityData = {
  aqi: number | null;
  pm25: number | null;
  pm10: number | null;
  observedAt: string | null;
  level: string | null;
  levelKey: string | null;
};

const roundNumber = (value: unknown) => (typeof value === 'number' && Number.isFinite(value) ? Math.round(value) : null);
const describeWeather = (code: unknown): string[] => WMO_CODES[Number(code) as keyof typeof WMO_CODES] ?? WMO_FALLBACK;
const aqiLevel = (aqi: number) => AQI_LEVELS.find(([limit]) => aqi <= limit) ?? AQI_LEVELS[AQI_LEVELS.length - 1];

function dayLabel(isoDate: string) {
  const [year, month, day] = (isoDate ?? '').split('-').map(Number);
  if (!year || !month || !day) return isoDate ?? '';
  const weekday = WEEKDAYS[new Date(Date.UTC(year, month - 1, day)).getUTCDay()];
  return `${weekday} ${day} ${MONTHS[month - 1]}`;
}

let weather: WeatherData | null = null;
let airQuality: AirQualityData | null = null;
try {
  const [forecastResponse, airResponse] = await Promise.allSettled([
    fetch(WEATHER_API, { headers: { accept: 'application/json' } }),
    fetch(WEATHER_AIR_API, { headers: { accept: 'application/json' } })
  ]);

  if (forecastResponse.status === 'fulfilled' && forecastResponse.value.ok) {
    const payload = await forecastResponse.value.json();
    const current = payload?.current ?? {};
    const daily = payload?.daily ?? {};
    weather = {
      temperature: roundNumber(current.temperature_2m),
      apparent: roundNumber(current.apparent_temperature),
      humidity: roundNumber(current.relative_humidity_2m),
      wind: roundNumber(current.wind_speed_10m),
      precipitation: typeof current.precipitation === 'number' ? current.precipitation : null,
      code: Number.isFinite(Number(current.weather_code)) ? Number(current.weather_code) : null,
      observedAt: current.time ?? null,
      days: (daily.time ?? []).map((date: string, index: number) => ({
        date,
        label: dayLabel(date),
        code: Number.isFinite(Number(daily.weather_code?.[index])) ? Number(daily.weather_code[index]) : null,
        max: roundNumber(daily.temperature_2m_max?.[index]),
        min: roundNumber(daily.temperature_2m_min?.[index]),
        rainChance: roundNumber(daily.precipitation_probability_max?.[index]),
        rainSum: typeof daily.precipitation_sum?.[index] === 'number' ? daily.precipitation_sum[index] : null,
        uv: typeof daily.uv_index_max?.[index] === 'number' ? Math.round(daily.uv_index_max[index] * 10) / 10 : null
      }))
    };
  }

  if (airResponse.status === 'fulfilled' && airResponse.value.ok) {
    const payload = await airResponse.value.json();
    const current = payload?.current ?? {};
    const aqi = roundNumber(current.us_aqi);
    airQuality = {
      aqi,
      pm25: roundNumber(current.pm2_5),
      pm10: roundNumber(current.pm10),
      observedAt: current.time ?? null,
      level: aqi == null ? null : aqiLevel(aqi)[1],
      levelKey: aqi == null ? null : aqiLevel(aqi)[2]
    };
  }
} catch {
  weather = null;
  airQuality = null;
}

const todayWeather = weather?.days?.[0] ?? null;
const needsUmbrella =
  (todayWeather?.rainChance ?? 0) >= 60 ||
  (todayWeather?.rainSum ?? 0) >= 2 ||
  (todayWeather?.code != null && WET_CODES.includes(todayWeather.code));
const hotDay = (todayWeather?.max ?? 0) >= 38;
const poorAir = (airQuality?.aqi ?? 0) > 150;
const weatherAdvice = needsUmbrella
  ? 'آج بارش کا امکان زیادہ ہے — چھتری یا بارش کوٹ ساتھ رکھیں اور پتھریلی گلیوں میں پھسلن کا خیال رکھیں۔'
  : hotDay
    ? 'آج گرمی کا دن ہے — پانی، ٹوپی اور دھوپ سے بچاؤ ساتھ رکھیں، واک صبح یا شام کو رکھیں۔'
    : poorAir
      ? 'ہوا کا معیار خراب ہے — حساس افراد ماسک پہنیں اور باہر زیادہ دیر ٹھہرنے سے گریز کریں۔'
      : 'موسم عام طور پر پیدل واک کے لیے موزوں ہے — پھر بھی پانی، ٹوپی اور آرام دہ جوتے بہتر ہیں۔';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${canonical}#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    'دہلی گیٹ',
    'دہلی دروازہ',
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    'دہلی گیٹ لاہور'
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: canonical,
  image: [ogImage, heroImageAbsolute],
  isAccessibleForFree: true,
  publicAccess: true,
  isPartOf: { '@type': 'TouristAttraction', name: 'Walled City of Lahore', url: WIKIPEDIA_URL },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'H8JG+PHM, Inside Delhi Gate, Akbari Mandi, Walled City of Lahore',
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL, WIKIPEDIA_URL, WIKIMEDIA_CATEGORY_URL],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '00:00', closes: '23:59' }
  ]
  // NOTE: aggregateRating / review intentionally omitted — review data is
  // third-party Google Maps content and stays in the visible page only.
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION_FULL_NAME, item: canonical },
    { '@type': 'ListItem', position: 2, name: CITY_NAME, item: 'https://en.wikipedia.org/wiki/Lahore' },
    { '@type': 'ListItem', position: 3, name: STATE_PROVINCE, item: 'https://en.wikipedia.org/wiki/Punjab,_Pakistan' },
    { '@type': 'ListItem', position: 4, name: COUNTRY_NAME, item: 'https://en.wikipedia.org/wiki/Pakistan' }
  ]
};

const faq = [
  ['دہلی گیٹ (Delhi Gate, Lahore) کہاں واقع ہے؟', `دہلی گیٹ لاہور، پنجاب، پاکستان کے فصیل بند پرانے شہر (Walled City of Lahore) کے مشرقی جانب اکبری منڈی کے قریب واقع ہے۔ پتہ: H8JG+PHM، Inside Delhi Gate، Akbari Mandi، Walled City of Lahore، Lahore ${POSTAL_CODE}، Pakistan؛ متناسقات ${LATITUDE}, ${LONGITUDE}۔`],
  ['دہلی گیٹ دیکھنے کی فیس کتنی ہے؟','خود تاریخی دروازہ اور بازار کی گزرگاہ عام طور پر بغیر ٹکٹ دیکھی جا سکتی ہے۔ شاہی حمام، خصوصی واک یا گائیڈڈ ٹور کی الگ فیس ہو سکتی ہے؛ روانگی سے پہلے WCLA کی تازہ معلومات دیکھیں۔'],
  ['کتنا وقت رکھنا بہتر ہے؟','صرف دروازے کے لیے 20–40 منٹ کافی ہو سکتے ہیں، مگر شاہی حمام، وزیر خان مسجد اور شاہی گزرگاہ کے ساتھ 2–3 گھنٹے زیادہ مناسب ہیں۔'],
  ['کون سا وقت بہتر ہے؟','صبح نسبتاً پرسکون روشنی اور کم ہجوم کے لیے اچھا ہے۔ شام میں بازار کا ماحول زیادہ زندہ محسوس ہوتا ہے، مگر ٹریفک اور رش بڑھ سکتا ہے۔'],
  ['پارکنگ کہاں ملتی ہے؟','دروازے کے عین اندر گاڑی لے جانا عملی نہیں۔ سرکلر روڈ کے اطراف دستیاب قانونی پارکنگ یا ڈراپ آف استعمال کریں اور آخری حصہ پیدل یا رکشہ سے طے کریں۔'],
  ['دہلی گیٹ کے قریب کون سی مشہور جگہیں ہیں؟', `دروازے سے اندر شاہی گزرگاہ پر ${NEARBY_LANDMARK_1} تقریباً 200 میٹر پر، ${NEARBY_LANDMARK_2} چند قدم کی دوری پر، اور گلی سرجن سنگھ، چوک وزیر خان، اکبری منڈی، لاہور قلعہ (Lahore Fort) اور بادشاہی مسجد (Badshahi Mosque) بھی اسی تاریخی شہر میں ہیں۔`],
  ['خاندان کے ساتھ جا سکتے ہیں؟','جی ہاں۔ یہ فعال بازار اور تاریخی محلہ ہے؛ بچوں کے ساتھ مصروف گلیوں میں ہاتھ تھامیں، آرام دہ جوتے پہنیں اور مذہبی مقامات پر لباس و آداب کا خیال رکھیں۔'],
  ['ہوائی اڈے سے دہلی گیٹ لاہور تک جانے کا بہترین طریقہ کیا ہے؟','لاہور کے بین الاقوامی ہوائی اڈے سے ٹیکسی یا مقامی رائیڈ ہیلنگ سروس کے ذریعے سرکلر روڈ پر واقع دہلی گیٹ تک پہنچنا سب سے آسان ہے؛ عام حالات میں یہ سفر تقریباً آدھے سے ایک گھنٹے کا ہے، مگر رش کے اوقات میں وقت بڑھ سکتا ہے۔'],
  [`${ATTRACTION_SHORT_NAME} دیکھنے کے لیے سال کا بہترین وقت کون سا ہے؟`,'فروری تا اپریل اور اکتوبر کے مہینے سب سے متوازن موسم دیتے ہیں — درجہ حرارت معتدل، بارش کم اور روشنی صاف۔ مئی تا جون میں شدید گرمی، جولائی تا ستمبر میں مون سون کی تیز بارشیں، اور دسمبر تا جنوری میں دھند و فضائی آلودگی زیادہ ہوتی ہے۔'],
  ['کیا دروازے کے قریب بیت الخلا، پارکنگ اور اے ٹی ایم ملتے ہیں؟','جی ہاں، مگر بنیادی نوعیت کے۔ بڑے تاریخی مقامات اور مساجد کے احاطوں کے قریب صفائی کی سہولت ملتی ہے، پارکنگ دروازے کے باہر سرکلر روڈ کے کنارے قانونی اور فیس والی جگہوں پر دستیاب ہے، اور اے ٹی ایم بڑی سڑکوں یا مارکیٹوں کی طرف ہیں۔ چھوٹی خریداری کے لیے نقد رقم ساتھ رکھیں۔']
];
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer', text:a} }))
};
---
<!doctype html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>دہلی گیٹ لاہور — Delhi Gate {CITY_NAME} | Visitor Guide &amp; Location</title>
  <meta name="description" content={`${ATTRACTION_FULL_NAME} (دہلی گیٹ لاہور) — ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} کا تاریخی مغلیہ دروازہ۔ محل وقوع، نقشہ، پتہ، اوقات، فیس، ${NEARBY_LANDMARK_1} اور ${NEARBY_LANDMARK_2} جیسے آس پاس کے مقامات، ٹرانسپورٹ اور ٹرپ ٹپس۔`} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />

  <!-- Local / geo meta -->
  <meta name="geo.region" content={`${COUNTRY_CODE_2LETTER}-PB`} />
  <meta name="geo.placename" content={CITY_NAME} />
  <meta name="geo.position" content={`${LATITUDE};${LONGITUDE}`} />
  <meta name="ICBM" content={`${LATITUDE}, ${LONGITUDE}`} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={`دہلی گیٹ لاہور — ${DOMAIN_NAME}`} />
  <meta property="og:locale" content="ur_PK" />
  <meta property="og:title" content={`دہلی گیٹ لاہور — ${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta property="og:description" content={`Official visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`دہلی گیٹ لاہور — ${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta name="twitter:description" content={`${ATTRACTION_FULL_NAME}, ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} — location, map, opening details and nearby landmarks.`} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- PWA -->
  <meta name="theme-color" content="#5e241e" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content="دہلی گیٹ لاہور" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Delhi Gate" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
