---
import '../styles/global.css';
import WeatherPanel from '../components/WeatherPanel.astro';
import * as attraction from '../data/attraction';

const {
  ATTRACTION_FULL_NAME,
  ATTRACTION_SHORT_NAME,
  CITY_NAME,
  COUNTRY_CODE_2LETTER,
  COUNTRY_NAME,
  DOMAIN_NAME,
  GOVT_TOURISM_URL,
  LATITUDE,
  LONGITUDE,
  MAPS_DIRECTIONS_URL,
  MAPS_EMBED_SRC,
  MAPS_SHARE_URL,
  MET_OFFICE_URL,
  NEARBY_LANDMARK_1,
  NEARBY_LANDMARK_2,
  POSTAL_CODE,
  RATING_COUNT,
  RATING_VALUE,
  REVIEW_CATEGORY_EN,
  REVIEW_SYNC_UR,
  STATE_PROVINCE,
  WIKIPEDIA_URL
} = attraction;


const site = Astro.site ?? new URL(`https://${DOMAIN_NAME}`);
const canonical = new URL("/", site).toString();
const ogImage = new URL("/images/og-cover.png", site).toString();
const ogImageAlt = `${ATTRACTION_FULL_NAME} — ${CITY_NAME}, ${COUNTRY_NAME}`;

// Weather estimates are requested only in the browser by WeatherPanel.


const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'HistoricalLandmark'],
  '@id': `https://${DOMAIN_NAME}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    'دہلی گیٹ',
    'دہلی دروازہ',
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    'دہلی گیٹ لاہور'
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: canonical,
  image: [ogImage],
  isPartOf: { '@type': 'TouristAttraction', name: 'Walled City of Lahore' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, 'https://doam.gov.pk/public/sites/6449', WIKIPEDIA_URL]
  // NOTE: aggregateRating / review intentionally omitted — review data is
  // third-party Google Maps content and stays in the visible page only.
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION_FULL_NAME, item: canonical },
    { '@type': 'ListItem', position: 2, name: CITY_NAME, item: 'https://en.wikipedia.org/wiki/Lahore' },
    { '@type': 'ListItem', position: 3, name: STATE_PROVINCE, item: 'https://en.wikipedia.org/wiki/Punjab,_Pakistan' },
    { '@type': 'ListItem', position: 4, name: COUNTRY_NAME, item: 'https://en.wikipedia.org/wiki/Pakistan' }
  ]
};

const faq = [
  ['دہلی گیٹ (Delhi Gate, Lahore) کہاں واقع ہے؟', `دہلی گیٹ لاہور، پنجاب، پاکستان کے فصیل بند پرانے شہر (Walled City of Lahore) کے مشرقی جانب اکبری منڈی کے قریب واقع ہے۔ پتہ: H8JG+PHM، Inside Delhi Gate، Akbari Mandi، Walled City of Lahore، Lahore ${POSTAL_CODE}، Pakistan؛ متناسقات ${LATITUDE}, ${LONGITUDE}۔`],
  ['دہلی گیٹ دیکھنے کی فیس کتنی ہے؟', 'گزرگاہ کی موجودہ فیس کی انتظامیہ سے تصدیق نہیں ہوئی۔ شاہی حمام اور WCLA ٹور کی فیس اور بکنگ الگ معلوم کریں۔'],
  ['کتنا وقت رکھنا بہتر ہے؟','صرف منصوبہ بندی کے موٹے اندازے: دروازے کے اطراف 20–40 منٹ یا الگ مقامات کی رسائی کی تصدیق پر وسیع دورے کے لیے 2–3 گھنٹے۔ قطار، ہجوم، نماز، بندش اور راستے کے مطابق وقت بدل سکتا ہے۔'],
  ['کون سا وقت بہتر ہے؟', 'رسائی اور موسم معلوم کر کے دن کی روشنی میں منصوبہ بنائیں۔ رات کی حفاظت کا جائزہ تصدیق شدہ نہیں۔'],
  ['دہلی گیٹ کے اوقاتِ دیکھنے کیا ہیں؟', 'گوگل میپس میں عام گزرگاہ 24 گھنٹے کھلی درج ہے (29 اکتوبر 2026ء)؛ انتظامیہ سے موجودہ رسائی کے اوقات یا فیس کی تصدیق نہیں ہوئی۔ اس سے رات کی حفاظت یا قریبی حمام، مسجد اور ٹور کی رسائی ثابت نہیں ہوتی۔ ہر مقام کے اوقات الگ معلوم کریں۔'],
  ['پارکنگ کہاں ملتی ہے؟','اپنے ڈرائیور یا مقامی انتظامیہ سے اس تاریخ کے لیے قانونی ڈراپ آف اور پارکنگ معلوم کریں۔ یہاں کسی جگہ، دستیابی، قیمت یا آگے کے راستے کی تصدیق نہیں۔'],
  ['دہلی گیٹ کے قریب کون سی مشہور جگہیں ہیں؟', `دروازے سے اندر شاہی گزرگاہ پر ${NEARBY_LANDMARK_1} تقریباً 200 میٹر پر، ${NEARBY_LANDMARK_2} چند قدم کی دوری پر، اور گلی سرجن سنگھ، چوک وزیر خان، اکبری منڈی، لاہور قلعہ (Lahore Fort) اور بادشاہی مسجد (Badshahi Mosque) بھی اسی تاریخی شہر میں ہیں۔`],
  ['خاندان کے ساتھ جا سکتے ہیں؟', 'گلیاں مصروف اور ناہموار ہو سکتی ہیں۔ راستہ اور سہولیات پہلے معلوم کریں؛ نقشے کا داخلی نشان پورے راستے کی رسائی کی ضمانت نہیں۔'],
  ['ہوائی اڈے سے دہلی گیٹ لاہور تک جانے کا بہترین طریقہ کیا ہے؟', 'مقامی ٹرانسپورٹ آپریٹر یا ٹیکسی سے موجودہ راستہ اور سرکلر روڈ پر قانونی ڈراپ آف معلوم کریں۔ ہوائی اڈے کا دورانیہ یا ٹائم ٹیبل یہاں تصدیق شدہ نہیں۔'],
  [`${ATTRACTION_SHORT_NAME} دیکھنے کے لیے سال کا بہترین وقت کون سا ہے؟`,'اپنی تاریخ کے لیے موجودہ پیش گوئی، فضائی معیار کی تنبیہات اور مقامی رسائی کے اعلانات دیکھیں۔ مخصوص موسمی اوسط کی تصدیق نہیں، اس لیے کسی مہینے میں خوشگوار موسم یا صاف ہوا کی ضمانت نہیں۔'],
  ['کیا دروازے کے قریب بیت الخلا، پارکنگ اور اے ٹی ایم ملتے ہیں؟', 'بیت الخلا، پارکنگ اور اے ٹی ایم کی موقع پر تصدیق نہیں ہوئی۔ متعلقہ مقام سے دستیابی اور بغیر سیڑھی رسائی معلوم کریں۔']
];
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer', text:a} }))
};
---
<!doctype html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>دہلی گیٹ لاہور (Delhi Gate) — اوقات، مقام، پارکنگ و رہنمائی زائرین</title>
  <meta name="description" content={`${ATTRACTION_FULL_NAME} (دہلی گیٹ لاہور) — ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} کا تاریخی مغلیہ دروازہ۔ اوقاتِ دیکھنے، محل وقوع، نقشہ، پتہ، فیس، پارکنگ، ${NEARBY_LANDMARK_1} اور ${NEARBY_LANDMARK_2} جیسے آس پاس کے مقامات، ٹرانسپورٹ اور ٹرپ ٹپس۔`} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />

  <!-- Language versions -->
  <link rel="alternate" hreflang="ur" href={canonical} />
  <link rel="alternate" hreflang="en" href={new URL('/en/', site).toString()} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Local / geo meta -->
  <meta name="geo.region" content={`${COUNTRY_CODE_2LETTER}-PB`} />
  <meta name="geo.placename" content={CITY_NAME} />
  <meta name="geo.position" content={`${LATITUDE};${LONGITUDE}`} />
  <meta name="ICBM" content={`${LATITUDE}, ${LONGITUDE}`} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={`دہلی گیٹ لاہور — ${DOMAIN_NAME}`} />
  <meta property="og:locale" content="ur_PK" />
  <meta property="og:title" content={`دہلی گیٹ لاہور — ${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta property="og:description" content={`Official visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`دہلی گیٹ لاہور — ${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta name="twitter:description" content={`${ATTRACTION_FULL_NAME}, ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} — location, map, opening details and nearby landmarks.`} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- PWA -->
  <meta name="theme-color" content="#5e241e" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content="دہلی گیٹ لاہور" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Delhi Gate" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

  <!-- Structured data: attraction entity, breadcrumb hierarchy, FAQ -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
</head>
<body>
  <header class="hero tile-border">
    <div class="container hero-content">
      <div class="eyebrow">اندرون لاہور · شاہی گزرگاہ</div>
      <h1>دہلی گیٹ لاہور</h1>
      <p class="hero-name"><bdi dir="ltr" lang="en">Delhi Gate, Lahore</bdi></p>
      <p>اندرون لاہور کا تاریخی مشرقی دروازہ، اکبری منڈی کے قریب۔ شاہی حمام اور وزیر خان مسجد کی رسائی اور اوقات الگ معلوم کریں۔</p>
      <div class="pills"><span class="pill">دہلی دروازے کی حقیقی تصویر</span>
        <a class="pill" href="#reviews" title="گوگل میپس پر جائزے">★ {RATING_VALUE} · {RATING_COUNT} جائزے</a>
        <span class="pill">تاریخی یادگار · {REVIEW_CATEGORY_EN}</span>
        <span class="pill">عام گزرگاہ — رسائی معلوم کریں</span>

        <span class="pill">{LATITUDE}, {LONGITUDE}</span>
      </div>
    </div>
  </header>

  <nav class="breadcrumb" aria-label="بریڈ کرومب">
    <div class="container breadcrumb-inner">
      <ol>
        <li><a href="/">دہلی گیٹ لاہور</a></li>
        <li><a href="#story">{CITY_NAME}</a></li>
        <li><a href="#visit">{STATE_PROVINCE}</a></li>
        <li aria-current="page">{COUNTRY_NAME}</li>
      </ol>
      <span class="breadcrumb-path">{ATTRACTION_FULL_NAME} → {CITY_NAME} → {STATE_PROVINCE} → {COUNTRY_NAME}</span>
    </div>
  </nav>

  <nav class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><img src="/icons/logo.svg" alt="دہلی گیٹ لاہور لوگو" />دہلی گیٹ لاہور</a>
      <a href="#story">تعارف</a><a href="#visit">وزٹ پلان</a><a href="#weather">موسم</a><a href="#seasons">سہ ماہی</a><a href="#transport">کیسے پہنچیں</a><a href="#services">سہولیات</a><a href="#history">تاریخ</a><a href="#nearby">قریب کے مقامات</a><a href="#routes">راستے</a><a href="#food">کھانا</a><a href="#responsibility">ذمہ داریاں</a><a href="#reviews">جائزے</a><a href="#map">نقشہ</a><a href="#faq">سوالات</a><a href="#sources">ذرائع</a>
      <a class="lang-switch" href="/en/" hreflang="en" lang="en">English</a>
    </div>
  </nav>

  <main id="top">
    <section id="story">
      <div class="container grid grid-2" style="align-items:center">
        <div>
          <div class="section-kicker">ایک دروازہ، پورا شہر</div>
          <h2>دہلی گیٹ کے بارے میں (About Delhi Gate, {CITY_NAME})</h2>
          <p class="lede">دہلی گیٹ لاہور کی مشرقی فصیل کا تاریخی دروازہ ہے جو دہلی کی سمت رخ کے باعث اس نام سے معروف ہے۔ محکمہ آثار قدیمہ اس کے اندر وزیر خان مسجد کی قربت بتاتا ہے۔ شاہی گزرگاہ اور بحالی کا تاریخی پس منظر موجودہ رسائی کا اعلان نہیں؛ ہر مقام کے اوقات اور بندش الگ معلوم کریں۔</p>
          <p>کیا آپ لاہور کے اندرون شہر کی سب سے مشہور تاریخی دہلیز تلاش کر رہے ہیں؟ یہیں سے پرانا شہر شروع ہوتا ہے: دروازے کے اندر داخل ہوتے ہی پتلی گلیاں، اینٹوں والی محرابیں اور کاشی کاری کے نمونے ایک ہی مسلسل تجربے میں بدل جاتے ہیں۔</p>
          <p>{ATTRACTION_FULL_NAME} کے قریب آ کر زائرین آسانی سے ارد گرد کے تاریخی مقامات دیکھ سکتے ہیں، جن میں <strong>{NEARBY_LANDMARK_1}</strong> اور <strong>{NEARBY_LANDMARK_2}</strong> سب سے نمایاں ہیں۔</p>
          <div class="card"><strong>کیا دیکھیں:</strong> دروازے کی اینٹوں والی محراب، اندرونی بازار، شاہی حمام، سبیل والی گلی، گلی سرجن سنگھ، چوک وزیر خان اور وزیر خان مسجد۔</div>
        </div>
        <div style="display:grid;gap:1rem">
          <div class="photo-card arch" style="min-height:320px">
            <img src="/images/delhi-gate-lahore.jpg" alt="لاہور کے دہلی دروازے کی اندرونی گزرگاہ کی حقیقی تصویر" loading="lazy" width="1860" height="1240" />
            <div class="caption">دہلی دروازے کی گزرگاہ — تصویر: Mubeenakram، CC BY-SA 4.0</div>
          </div>
          <div class="photo-card arch" style="min-height:320px">
            <img src="/images/wazir-entry.jpg" alt="وزیر خان مسجد کے داخلے سے تاریخی منظر، 2016ء" loading="lazy" width="1280" height="1264" />
            <div class="caption">وزیر خان مسجد — تصویر: Shahbaz Aslam، CC BY-SA 4.0</div>
          </div>
        </div>
      </div>
    </section>

    <section id="visit" style="background:#f0d9b522"><div class="container"><p class="card">نقشے کے اوقات صرف عام گزرگاہ کا اندراج ہیں؛ موجودہ رسائی اور ہر عمارت کے اوقات الگ معلوم کریں۔</p></div>
      <div class="container">
        <div class="section-kicker">آنے سے پہلے</div><h2>عملی وزیٹر گائیڈ (Visitor Guide for {ATTRACTION_SHORT_NAME})</h2>
        <div class="grid grid-3">
          <article class="card"><h3>🎟️ ٹکٹ / فیس</h3><p>گزرگاہ کی موجودہ فیس انتظامیہ سے تصدیق شدہ نہیں۔ حمام، مسجد اور ٹور کی شرائط الگ معلوم کریں۔</p></article>
          <article class="card"><h3>🕰️ بہترین وقت</h3><p>رسائی، مقامی ہدایات اور موسم معلوم کر کے دن کی روشنی میں منصوبہ بنائیں۔ ہجوم اور ٹریفک بدلتے رہتے ہیں۔</p></article>
          <article class="card"><h3>⏳ قیام</h3><p>صرف منصوبہ بندی کے موٹے اندازے: دروازے کے اطراف 20–40 منٹ یا الگ مقامات کی تصدیق پر وسیع دورے کے لیے 2–3 گھنٹے؛ قطار، نماز، بندش اور راستے سے وقت بدلتا ہے۔</p></article>
          <article class="card"><h3>🚗 پارکنگ</h3><p>ڈرائیور یا مقامی انتظامیہ سے قانونی ڈراپ آف اور پارکنگ معلوم کریں۔ یہاں جگہ، دستیابی یا آگے کے راستے کی تصدیق نہیں ہوئی۔</p></article>
          <article class="card"><h3>👟 کیا ساتھ رکھیں</h3><p>آرام دہ جوتے، پانی، دھوپ میں ٹوپی اور مسجد کے لیے باوقار لباس۔ ہجوم میں موبائل و بٹوے کا خیال رکھیں۔</p></article>
          <article class="card"><h3>📷 فوٹوگرافی</h3><p>عام اسٹریٹ فوٹوگرافی میں لوگوں کی پرائیویسی کا خیال رکھیں۔ تجارتی شوٹ کے لیے WCLA کے اجازت نامے/فیس لاگو ہو سکتے ہیں۔</p></article>
        </div>
      </div>
    </section>

    <WeatherPanel lang="ur" />


    <section id="seasons"><div class="container"><h2>موسم کے مطابق منصوبہ بندی</h2><p class="lede">اپنی تاریخ کے لیے محکمہ موسمیات پاکستان کی پیش گوئی اور فضائی آلودگی کی تنبیہات دیکھیں۔ گرمی، بارش اور سردیوں کی دھند سفر پر اثر ڈال سکتی ہے۔ یہ ماہانہ اوسط یا صاف موسم کی ضمانت نہیں۔ مقامی رسائی معلوم کر کے دن کی روشنی میں منصوبہ بنائیں؛ موسم سے راستے کی حفاظت ثابت نہیں ہوتی۔</p></div></section>

    <section id="transport"><div class="container"><h2>دہلی گیٹ تک رسائی</h2><p class="lede">اکبری منڈی کے قریب مشرقی دروازے کا نقشہ استعمال کریں۔ ڈرائیور سے سرکلر روڈ پر قانونی ڈراپ آف اور موجودہ پابندیاں معلوم کریں؛ سرکلر روڈ، لاہور رنگ روڈ نہیں ہے۔ ہوائی اڈے کے سفر کا وقت، پارکنگ یا پبلک ٹرانسپورٹ کا ٹائم ٹیبل یہاں تصدیق شدہ نہیں۔ متعلقہ آپریٹر سے راستہ اور آخری سروس معلوم کریں۔ آخری حصہ مصروف اور ناہموار ہو سکتا ہے۔</p></div></section>

    <section id="services"><div class="container"><h2>سہولیات اور رسائی کی تصدیق</h2><p class="lede">بیت الخلا، بغیر سیڑھی رسائی، پارکنگ اور اے ٹی ایم کی موقع پر تصدیق نہیں ہوئی۔ میپس پر قابل رسائی داخلی راستے کا نشان پورے راستے، سطح، ریمپ یا اندرونی حصوں کی تصدیق نہیں۔ روانگی سے پہلے ہر مقام سے سہولیات، دہلیز، مدد اور اوقات معلوم کریں۔</p></div></section>

    <section id="history"><div class="container"><div class="section-kicker">تاریخ اور فن تعمیر</div><h2>سرکاری تاریخی ریکارڈ کیا بتاتا ہے؟</h2><div class="grid grid-2"><article class="card"><h3>تاریخی شناخت</h3><p>محکمہ آثار قدیمہ دہلی گیٹ کو لاہور کی مشرقی فصیل میں دہلی کی سمت واقع دروازہ قرار دیتا ہے، جس کے اندر وزیر خان مسجد قریب ہے۔ ریکارڈ میں ملکیت حکومت پنجاب اور قانون آثار قدیمہ 1975ء (ترمیم 1992ء) کے تحت تحفظ درج ہے۔</p><p>ریکارڈ کا وسیع تاریخی دور 1526–1857ء ہے۔ یہ موجودہ عمارت کے ہر حصے کی تعمیر کی مصدقہ تاریخ نہیں؛ یہاں لکڑی، رنگ یا مرمت کو کسی مخصوص دور سے منسوب نہیں کیا گیا۔</p></article><article class="card"><h3>دروازہ، بازار اور شاہی گزرگاہ</h3><p>WCLA کے مطابق مسجد دروازے کے تقریباً 200 میٹر اندر اور شاہی حمام قریب ہے۔ تاریخی شہری محلے کا یہ داخلہ اس بات کا ثبوت نہیں کہ تمام قریبی عمارتوں کی داخلہ شرائط ایک ہیں۔</p><p>شاہی گزرگاہ یا تاریخی بحالی کی تفصیل موجودہ کھلنے کا اعلان نہیں۔ سفر سے پہلے رسائی، رکاوٹیں، ہر مقام کے اوقات اور ٹور کی بکنگ الگ معلوم کریں۔</p><p><a href="https://doam.gov.pk/public/sites/6449">محکمہ آثار قدیمہ — دہلی گیٹ</a> · <a href={GOVT_TOURISM_URL}>WCLA — دروازے</a></p></article></div></div></section>

    <section id="nearby" style="background:#fff9ef">
      <div class="container"><div class="section-kicker">پیدل دریافت کریں</div><h2>{ATTRACTION_SHORT_NAME} کے آس پاس کے مقامات (Landmarks &amp; Attractions Around {ATTRACTION_SHORT_NAME})</h2>
        <p class="lede">{ATTRACTION_FULL_NAME} کا دورہ کرتے ہوئے زائرین آسانی سے ارد گرد کے تاریخی مقامات اور دلچسپی کے مقامات دیکھ سکتے ہیں، جن میں <strong>{NEARBY_LANDMARK_1}</strong> اور <strong>{NEARBY_LANDMARK_2}</strong> نمایاں ہیں۔ یہ سب اسی فصیل بند شہر کے اندر پیدل فاصلے پر ہیں۔</p>
        <div class="grid grid-3">
          <article class="card"><h3>شاہی حمام</h3><p>دہلی گیٹ سے چند قدم اندر۔ مغلیہ دور کا واحد باقی ماندہ عوامی حمام، جس میں فریسکو اور زیرِفرش حرارتی نظام کے آثار دیکھے جا سکتے ہیں۔</p></article>
          <article class="card"><h3>وزیر خان مسجد</h3><p>تقریباً 200 میٹر اندر شاہی گزرگاہ پر۔ کاشی کاری، خطاطی اور رنگین نقش و نگار کے لیے لاہور کی نمایاں مغلیہ مسجد۔</p></article>
          <article class="card"><h3>گلی سرجن سنگھ</h3><p>بحال شدہ تاریخی گلی، لکڑی کے جھروکوں اور روایتی رہائشی کردار کے ساتھ اندرون لاہور کی باریک شہری ساخت دکھاتی ہے۔</p></article>
          <article class="card"><h3>چوک وزیر خان</h3><p>مسجد کے سامنے تاریخی شہری چوک؛ آس پاس کرافٹ بازار، حویلیاں اور پرانے تجارتی راستے ہیں۔</p></article>
          <article class="card"><h3>اکبری منڈی</h3><p>دہلی گیٹ کے قریب قدیم تھوک بازار، جہاں مصالحوں اور اناج کی تجارت نے علاقے کی شناخت بنائی۔</p></article>
          <article class="card"><h3>قلعہ لاہور و بادشاہی مسجد</h3><p>اسی تاریخی شہر کے مغربی سرے پر۔ دہلی گیٹ سے مکمل شاہی گزرگاہ واک کی قدرتی منزلیں، مگر فاصلہ نسبتاً زیادہ ہے۔</p></article>
        </div>
      </div>
    </section>

    <section id="routes"><div class="container"><h2>راستے کے خیالات — ہر مقام الگ معلوم کریں</h2><p class="lede">پہلے دروازے کا بیرونی حصہ دیکھنے کا منصوبہ بنائیں، پھر انتظامیہ کی تصدیق پر شاہی حمام اور وزیر خان مسجد شامل کریں۔ WCLA کے مطابق مسجد دروازے کے تقریباً 200 میٹر اندر ہے؛ یہ سمت کی معلومات ہے، قابل رسائی پیدل راستے کی تصدیق نہیں۔ قطار، نماز، بندش اور ٹریفک کے لیے وقت رکھیں۔ WCLA کی شام کی واک الگ بکنگ والی سرگرمی ہے، آزاد رات کی رسائی کا ثبوت نہیں۔</p></div></section>

    <section id="food">
      <div class="container">
        <div class="section-kicker">لاہوری ذائقہ</div><h2>آس پاس کیا کھائیں</h2>
        <div class="grid grid-3">
          <article class="card"><h3>روایتی ناشتہ</h3><p>پرانے شہر میں حلوہ پوری، چنے، نان اور لسی عام انتخاب ہیں۔ صبح کی واک کے ساتھ ناشتے کا وقفہ بہترین رہتا ہے۔</p></article>
          <article class="card"><h3>بازار کے اسنیکس</h3><p>سموسہ، پکوڑے، چائے اور موسمی مٹھائیاں گلیوں میں آسانی سے مل جاتی ہیں۔ مصروف دکان اور تازہ تیار ہونے والی چیز کو ترجیح دیں۔</p></article>
          <article class="card"><h3>فورٹ روڈ فوڈ اسٹریٹ</h3><p>اگر آپ واک قلعہ لاہور کی طرف مکمل کریں تو فورٹ روڈ کے ریستوران لاہور کے کلاسک پکوان اور بادشاہی مسجد کے نظارے کے لیے مشہور ہیں۔</p></article>
        </div>
        <p class="credit">نوٹ: کاروباری اوقات اور دکانوں کی دستیابی تیزی سے بدل سکتی ہے؛ اسی دن نقشہ/فون سے تصدیق بہتر ہے۔</p>
      </div>
    </section>

    <section id="responsibility" style="background:#f7efe3">
      <div class="container">
        <div class="section-kicker">سائنس اور ذمہ داری</div>
        <h2>تعمیراتی سائنس اور زائرین کی ذمہ داریاں (Science &amp; Visitor Responsibility)</h2>
        <p class="lede">{ATTRACTION_SHORT_NAME} اور شاہی گزرگاہ کی عمارتیں چنئی اور اینٹوں سے بنی ہیں، جن کی سب سے بڑی دشمن نمی، نمک اور ارتعاش ہے۔ یہ سمجھنا ضروری ہے کہ زائرین کی چھوٹی سی عادت — دیوار کو ہاتھ لگانا، پانی کا چھڑکاؤ، رگڑ یا دیوار پر کھڑا ہونا — صدیوں پرانی سطح کو نقصان پہنچا سکتی ہے۔</p>
        <div class="grid grid-2">
          <article class="card">
            <h3>🔬 تعمیراتی مواد کیوں کمزور ہے</h3>
            <p>چونے کی سیمنٹ اور پکی اینٹ پانی جذب کرتے ہیں۔ جب نمی بخارات بن کر اوپر آتی ہے تو اندر موجود نمکیات سطح پر آ کر پھول جاتے ہیں (نمک کا پھولنا)، جس سے ٹائل اور پلاستر کے ذرات جھڑنے لگتے ہیں۔ بارش یا سیپیج زیادہ ہو تو دیواریں کمزور ہو جاتی ہیں، اور مسلسل ارتعاش یا مسلسل چھونے سے فریسکو اور کاشی کاری کی سطحیں گھس جاتی ہیں۔</p>
            <p>اسی لیے حمام کے فریسکو اور {NEARBY_LANDMARK_1} کی ٹائل کاری کے قریب مخصوص فاصلہ رکھا جاتا ہے: انسانوں کی تعداد، پسینے میں موجود نمک اور ہاتھوں کی رگڑ سب مل کر سطح کی عمر گھٹاتے ہیں۔</p>
          </article>
          <article class="card">
            <h3>✅ زائرین کے لیے عملی اصول</h3>
            <ul class="src-list">
              <li>دیواروں، فریسکو اور ٹائل کاری کو ہاتھ نہ لگائیں اور نہ ان پر ٹیک لگائیں۔</li>
              <li>دیواروں پر لکھنا، نقش بنانا یا کوئی نشان چھوڑنا ممنوع ہے۔</li>
              <li>تاریخی ڈھانچوں پر نہ چڑھیں اور نہ بیٹھیں؛ ٹرائی پاڈ یا ڈرون کے لیے پہلے اجازت لیں۔</li>
              <li>تنگ گلیوں میں راستہ بند نہ کریں؛ مقامی لوگوں کے روزمرہ راستے کا احترام کریں۔</li>
              <li>کوڑا مقررہ جگہ پر ڈالیں اور پانی کی بوتلیں ساتھ لے جائیں۔</li>
              <li>عبادت گاہوں میں باوقار لباس، خاموشی اور نماز کے اوقات کا احترام کریں۔</li>
              <li>لوگوں کی تصویر لینے سے پہلے اجازت لیں، دکان دار سے قیمت پہلے تصدیق کریں۔</li>
              <li>مقامی دستکاری خرید کر اور مقامی رہنما سروسز استعمال کر کے تحفظ کی معاشی مدد کریں۔</li>
            </ul>
          </article>
        </div>
        <p class="credit">یہ سائٹ ایک آزاد معلوماتی رہنما ہے: ہم کسی کاروبار کی سفارش نہیں کرتے، ٹکٹ یا فیس وصول نہیں کرتے اور مقامی اداروں کی ترتیب دی گئی ہدایات ہمیشہ اولیت رکھتی ہیں۔</p>
      </div>
    </section>

