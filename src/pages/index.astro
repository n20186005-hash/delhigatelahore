  <main id="top">
    <section id="story">
      <div class="container grid grid-2" style="align-items:center">
        <div>
          <div class="section-kicker">ایک دروازہ، پورا شہر</div>
          <h2>دہلی گیٹ کے بارے میں (About Delhi Gate, {CITY_NAME})</h2>
          <p class="lede">دہلی گیٹ لاہور کے فصیل بند شہر کے باقی ماندہ تاریخی دروازوں میں سے ایک ہے۔ یہ مشرقی جانب اس راستے پر واقع ہے جو کبھی قلعہ لاہور کو دہلی کی سمت جانے والے شاہی راستے سے جوڑتا تھا۔ آج بھی اس کے اندر بازار، شاہی حمام اور وزیر خان مسجد تک پھیلی شاہی گزرگاہ پر شہری زندگی پوری شدت سے جاری ہے۔</p>
          <p>کیا آپ لاہور کے اندرون شہر کی سب سے مشہور تاریخی دہلیز تلاش کر رہے ہیں؟ یہیں سے پرانا شہر شروع ہوتا ہے: دروازے کے اندر داخل ہوتے ہی پتلی گلیاں، اینٹوں والی محرابیں اور کاشی کاری کے نمونے ایک ہی مسلسل تجربے میں بدل جاتے ہیں۔</p>
          <p>{ATTRACTION_FULL_NAME} کے قریب آ کر زائرین آسانی سے ارد گرد کے تاریخی مقامات دیکھ سکتے ہیں، جن میں <strong>{NEARBY_LANDMARK_1}</strong> اور <strong>{NEARBY_LANDMARK_2}</strong> سب سے نمایاں ہیں۔</p>
          <div class="card"><strong>کیا دیکھیں:</strong> دروازے کی اینٹوں والی محراب، اندرونی بازار، شاہی حمام، سبیل والی گلی، گلی سرجن سنگھ، چوک وزیر خان اور وزیر خان مسجد۔</div>
        </div>
        <div class="photo-card arch">
          <img src="https://upload.wikimedia.org/wikipedia/commons/2/28/Wazir_khan_mosque_entry.jpg" alt={`${NEARBY_LANDMARK_1} — ${ATTRACTION_SHORT_NAME}, ${CITY_NAME} کے قریب مشہور مغلیہ مسجد کا صحن`} loading="lazy" width="1200" height="900" />
          <div class="caption">وزیر خان مسجد — تصویر: Shahbaz Aslam، CC BY-SA 4.0</div>
        </div>
      </div>
    </section>

    <section id="visit" style="background:#f0d9b522">
      <div class="container">
        <div class="section-kicker">آنے سے پہلے</div><h2>عملی وزیٹر گائیڈ (Visitor Guide for {ATTRACTION_SHORT_NAME})</h2>
        <div class="grid grid-3">
          <article class="card"><h3>🎟️ ٹکٹ / فیس</h3><p>دہلی گیٹ کی عام گزرگاہ کے لیے الگ داخلہ ٹکٹ نہیں۔ WCLA کے گائیڈڈ واک، خصوصی ایونٹس یا اندرونی تاریخی عمارتوں کے نرخ الگ ہو سکتے ہیں۔</p></article>
          <article class="card"><h3>🕰️ بہترین وقت</h3><p>صبح 8 سے 10 بجے فوٹوگرافی، کم رش اور نرم روشنی کے لیے اچھا رہتا ہے۔ شام کو بازار زیادہ زندہ ہوتا ہے مگر ٹریفک بھی بڑھ جاتی ہے۔</p></article>
          <article class="card"><h3>⏳ قیام</h3><p>صرف گیٹ کے لیے 20–40 منٹ؛ شاہی حمام اور وزیر خان مسجد سمیت تاریخی واک کے لیے تقریباً 2–3 گھنٹے رکھیں۔</p></article>
          <article class="card"><h3>🚗 پارکنگ</h3><p>اندرون شہر کی گلیاں تنگ ہیں۔ سرکلر روڈ کے اطراف قانونی پارکنگ/ڈراپ آف بہتر ہے؛ آخری حصہ پیدل یا رکشے پر کریں۔</p></article>
          <article class="card"><h3>👟 کیا ساتھ رکھیں</h3><p>آرام دہ جوتے، پانی، دھوپ میں ٹوپی اور مسجد کے لیے باوقار لباس۔ ہجوم میں موبائل و بٹوے کا خیال رکھیں۔</p></article>
          <article class="card"><h3>📷 فوٹوگرافی</h3><p>عام اسٹریٹ فوٹوگرافی میں لوگوں کی پرائیویسی کا خیال رکھیں۔ تجارتی شوٹ کے لیے WCLA کے اجازت نامے/فیس لاگو ہو سکتے ہیں۔</p></article>
        </div>
      </div>
    </section>

    <section id="weather" style="background:#eef3f7">
      <div class="container">
        <div class="section-kicker">موسم اور پیش گوئی</div>
        <h2>{ATTRACTION_SHORT_NAME}، {CITY_NAME} کا آج کا موسم اور 7 دن کی پیش گوئی</h2>
        {weather ? (
          <div class="wx-wrap">
            <article class="wx-now">
              <div class="wx-now-head">
                <span class="wx-glyph" id="wx-glyph">{describeWeather(weather.code)[1]}</span>
                <span class="wx-temp"><strong id="wx-temp">{weather.temperature}</strong>°</span>
                <span class="wx-unit">سینٹی گریڈ · {CITY_NAME}</span>
              </div>
              <p class="wx-now-desc" id="wx-desc">{describeWeather(weather.code)[0]}</p>
              <ul class="wx-metrics">
                <li><span>محسوس ہوتا ہے</span><strong><span id="wx-feels">{weather.apparent}</span>°</strong></li>
                <li><span>نمی</span><strong><span id="wx-hum">{weather.humidity}</span>%</strong></li>
                <li><span>ہوا کی رفتار</span><strong><span id="wx-wind">{weather.wind}</span> کلومیٹر/گھنٹہ</strong></li>
                <li><span>گزشتہ گھنٹے کی بارش</span><strong><span id="wx-precip">{weather.precipitation ?? 0}</span> ملی میٹر</strong></li>
              </ul>
              <p class="wx-clock" id="wx-clock">تازہ کاری: {(weather.observedAt ?? '').replace('T', ' · ')}</p>
            </article>
            <div class="wx-side">
              <div class="wx-advice">
                <h3>آج کا مشورہ</h3>
                <p id="wx-advice">{weatherAdvice}</p>
              </div>
              {airQuality ? (
                <div class={`wx-air wx-air-${airQuality.levelKey ?? 'unknown'}`}>
                  <h3>ہوا کا معیار</h3>
                  <p class="wx-air-aqi">اشاریہ <strong id="wx-aqi">{airQuality.aqi}</strong> · <span id="wx-aqi-label">{airQuality.level}</span></p>
                  <p class="wx-air-pm">باریک ذرات (PM2.5): <strong id="wx-pm25">{airQuality.pm25}</strong> · موٹے ذرات (PM10): <strong id="wx-pm10">{airQuality.pm10}</strong></p>
                </div>
              ) : (
                <div class="wx-air">
                  <h3>ہوا کا معیار</h3>
                  <p>ہوا کے معیار کی تازہ معلومات اس وقت دستیاب نہیں۔</p>
                </div>
              )}
            </div>
          </div>
          <ul class="wx-days">
            {weather.days.map((day, index) => (
              <li class="wx-day" data-day={String(index)}>
                <span class="wx-day-name">{day.label}</span>
                <span class="wx-day-glyph" data-glyph>{describeWeather(day.code)[1]}</span>
                <span class="wx-day-desc" data-desc>{describeWeather(day.code)[0]}</span>
                <span class="wx-day-temps"><strong data-max>{day.max}</strong>° / <span data-min>{day.min}</span>°</span>
                <span class="wx-day-rain">بارش کا امکان <strong data-pop>{day.rainChance}</strong>%</span>
              </li>
            ))}
          </ul>
          <p class="credit">موسمی اعداد و شمار شہر کے لیے دیے گئے ہیں؛ اندرون شہر کی تنگ گلیوں میں دھوپ، ہوا اور محسوس ہونے والی گرمی مختلف ہو سکتی ہے۔ طویل المدتی اوسط کے لیے سرکاری موسمیاتی ادارہ دیکھیں۔</p>
        ) : (
          <p class="lede">موسم کی معلومات اس وقت دستیاب نہیں۔ روانگی سے پہلے سرکاری موسمیاتی ادارے کی تازہ پیش گوئی ضرور دیکھیں، تاکہ بارش، گرمی یا دھند کے مطابق منصوبہ بندی ہو سکے۔</p>
        )}
      </div>
    </section>

    <script is:inline>
      // Keeps the prerendered weather panel current while the page stays static.
      (function () {
        var panel = document.getElementById('weather');
        if (!panel || !window.fetch) return;

        var FORECAST = 'https://api.open-meteo.com/v1/forecast?latitude=31.5821649&longitude=74.3264164&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&forecast_days=7&timezone=Asia%2FKarachi';
        var AIR = 'https://air-quality-api.open-meteo.com/v1/air-quality?latitude=31.5821649&longitude=74.3264164&current=us_aqi,pm2_5,pm10&timezone=Asia%2FKarachi';
        var CODES = { 0: ['صاف آسمان', '☀️'], 1: ['عموماً صاف', '🌤️'], 2: ['جزوی بادل', '⛅'], 3: ['ابراہ', '☁️'], 45: ['دھند', '🌫️'], 48: ['جمی ہوئی دھند', '🌫️'], 51: ['ہلکی بوندا باندی', '🌦️'], 53: ['درمیانی بوندا باندی', '🌦️'], 55: ['گہری بوندا باندی', '🌧️'], 56: ['ہلکی برفانی بوندا باندی', '🌧️'], 57: ['گہری برفانی بوندا باندی', '🌧️'], 61: ['ہلکی بارش', '🌧️'], 63: ['درمیانی بارش', '🌧️'], 65: ['تیز بارش', '🌧️'], 66: ['ہلکی برفانی بارش', '🌨️'], 67: ['تیز برفانی بارش', '🌨️'], 71: ['ہلکی برفباری', '🌨️'], 73: ['درمیانی برفباری', '🌨️'], 75: ['شدید برفباری', '❄️'], 77: ['برف کے دانے', '🌨️'], 80: ['ہلکی جھڑی', '🌦️'], 81: ['درمیانی جھڑی', '🌧️'], 82: ['تیز جھڑی', '⛈️'], 85: ['ہلکی برفانی جھڑی', '🌨️'], 86: ['شدید برفانی جھڑی', '❄️'], 95: ['گرج چمک کے ساتھ بارش', '⛈️'], 96: ['گرج چمک اور اولے', '⛈️'], 99: ['شدید گرج چمک اور اولے', '⛈️'] };
        var LEVELS = [[50, 'اچھا', 'good'], [100, 'درمیانہ', 'moderate'], [150, 'حساس افراد کے لیے غیر صحت بخش', 'sensitive'], [200, 'غیر صحت بخش', 'unhealthy'], [300, 'بہت غیر صحت بخش', 'very-unhealthy'], [1e9, 'خطرناک', 'hazardous']];
        var WET = [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82, 85, 86, 95, 96, 99];
        var WEEKDAYS = ['اتوار', 'پیر', 'منگل', 'بدھ', 'جمعرات', 'جمعہ', 'ہفتہ'];
        var MONTHS = ['جنوری', 'فروری', 'مارچ', 'اپریل', 'مئی', 'جون', 'جولائی', 'اگست', 'ستمبر', 'اکتوبر', 'نومبر', 'دسمبر'];
        var CACHE_KEY = 'delhi-gate-weather';
        var TTL = 15 * 60 * 1000;

        function text(id, value) {
          var el = document.getElementById(id);
          if (el && value != null) el.textContent = value;
        }
        function round(value) {
          return typeof value === 'number' && isFinite(value) ? Math.round(value) : value;
        }
        function describe(code) {
          return CODES[Number(code)] || ['موسمی معلومات دستیاب نہیں', '🌡️'];
        }
        function level(value) {
          for (var i = 0; i < LEVELS.length; i++) if (value <= LEVELS[i][0]) return LEVELS[i];
          return LEVELS[LEVELS.length - 1];
        }
        function labelFor(iso) {
          var parts = String(iso || '').split('-');
          if (parts.length !== 3) return iso;
          var d = new Date(Date.UTC(+parts[0], +parts[1] - 1, +parts[2]));
          return WEEKDAYS[d.getUTCDay()] + ' ' + (+parts[2]) + ' ' + MONTHS[+parts[1] - 1];
        }

        function apply(data) {
          if (!data || !data.current) return;
          var current = data.current;
          var daily = data.daily || {};
          var todayRain = daily.precipitation_probability_max ? daily.precipitation_probability_max[0] : 0;
          var todayCode = daily.weather_code ? daily.weather_code[0] : current.weather_code;
          var todayMax = daily.temperature_2m_max ? daily.temperature_2m_max[0] : current.temperature_2m;

          text('wx-temp', round(current.temperature_2m));
          text('wx-feels', round(current.apparent_temperature));
          text('wx-hum', round(current.relative_humidity_2m));
          text('wx-wind', round(current.wind_speed_10m));
          text('wx-precip', typeof current.precipitation === 'number' ? current.precipitation : 0);
          var desc = describe(current.weather_code);
          text('wx-glyph', desc[1]);
          text('wx-desc', desc[0]);
          if (current.time) text('wx-clock', 'تازہ کاری: ' + current.time.replace('T', ' · '));

          var advice = todayRain >= 60 || (WET.indexOf(Number(todayCode)) > -1)
            ? 'آج بارش کا امکان زیادہ ہے — چھتری یا بارش کوٹ ساتھ رکھیں اور پتھریلی گلیوں میں پھسلن کا خیال رکھیں۔'
            : (round(todayMax) >= 38
              ? 'آج گرمی کا دن ہے — پانی، ٹوپی اور دھوپ سے بچاؤ ساتھ رکھیں، واک صبح یا شام کو رکھیں۔'
              : 'موسم عام طور پر پیدل واک کے لیے موزوں ہے — پھر بھی پانی، ٹوپی اور آرام دہ جوتے بہتر ہیں۔');
          text('wx-advice', advice);

          var cards = panel.querySelectorAll('.wx-day');
          if (cards && daily.time) {
            daily.time.forEach(function (iso, index) {
              var card = panel.querySelector('.wx-day[data-day="' + index + '"]');
              if (!card) return;
              var info = describe(daily.weather_code ? daily.weather_code[index] : null);
              var name = card.querySelector('.wx-day-name');
              var glyph = card.querySelector('[data-glyph]');
              var descr = card.querySelector('[data-desc]');
              var max = card.querySelector('[data-max]');
              var min = card.querySelector('[data-min]');
              var pop = card.querySelector('[data-pop]');
              if (name) name.textContent = labelFor(iso);
              if (glyph) glyph.textContent = info[1];
              if (descr) descr.textContent = info[0];
              if (max) max.textContent = round(daily.temperature_2m_max ? daily.temperature_2m_max[index] : null);
              if (min) min.textContent = round(daily.temperature_2m_min ? daily.temperature_2m_min[index] : null);
              if (pop) pop.textContent = round(daily.precipitation_probability_max ? daily.precipitation_probability_max[index] : null);
            });
          }
        }

        function applyAir(data) {
          if (!data || !data.current) return;
          var current = data.current;
          var value = round(current.us_aqi);
          text('wx-aqi', value);
          text('wx-pm25', round(current.pm2_5));
          text('wx-pm10', round(current.pm10));
          var info = level(current.us_aqi);
          text('wx-aqi-label', info[1]);
          var chip = panel.querySelector('.wx-air');
          if (chip) {
            chip.className = 'wx-air wx-air-' + info[2];
            if (current.us_aqi > 150) {
              var el = document.getElementById('wx-advice');
              if (el) el.textContent = 'ہوا کا معیار خراب ہے — حساس افراد ماسک پہنیں اور باہر زیادہ دیر ٹھہرنے سے گریز کریں۔';
            }
          }
        }

        function readCache() {
          try {
            var raw = window.localStorage.getItem(CACHE_KEY);
            if (!raw) return null;
            var parsed = JSON.parse(raw);
            return parsed && Date.now() - parsed.at < TTL ? parsed : null;
          } catch (error) {
            return null;
          }
        }

        function refresh() {
          var jobs = [
            fetch(FORECAST).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; }),
            fetch(AIR).then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; })
          ];
          return Promise.all(jobs).then(function (results) {
            if (!results[0] && !results[1]) return null;
            if (results[0]) apply(results[0]);
            if (results[1]) applyAir(results[1]);
            try {
              window.localStorage.setItem(CACHE_KEY, JSON.stringify({ at: Date.now(), data: results[0], air: results[1] }));
            } catch (error) {}
            return true;
          });
        }

        var cached = readCache();
        if (cached) {
          apply(cached.data);
          applyAir(cached.air);
        } else {
          refresh();
        }
        setInterval(function () {
          if (document.visibilityState === 'visible') refresh();
        }, TTL);
      })();
    </script>

