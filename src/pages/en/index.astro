---
import '../../styles/global.css';
import WeatherRefresh from '../../components/WeatherRefresh.astro';
import * as attraction from '../../data/attraction';
import { describeWeather, loadWeather } from '../../lib/weather';

const {
  ATTRACTION_FULL_NAME,
  ATTRACTION_SHORT_NAME,
  CITY_NAME,
  COUNTRY_CODE_2LETTER,
  COUNTRY_NAME,
  DOMAIN_NAME,
  GOVT_TOURISM_URL,
  GOVT_TOURISM_URL_ALT,
  HERO_IMAGE_ABSOLUTE,
  LATITUDE,
  LONGITUDE,
  MAPS_DIRECTIONS_URL,
  MAPS_EMBED_SRC,
  MAPS_SHARE_URL,
  MET_OFFICE_URL,
  NEARBY_LANDMARK_1,
  NEARBY_LANDMARK_2,
  POSTAL_CODE,
  RATING_COUNT,
  RATING_MAX,
  RATING_VALUE,
  REVIEW_CATEGORY_EN,
  REVIEW_SYNC_EN,
  STATE_PROVINCE,
  WIKIMEDIA_CATEGORY_URL,
  WIKIPEDIA_URL
} = attraction;

const heroImageAbsolute = HERO_IMAGE_ABSOLUTE;

const site = Astro.site ?? new URL(`https://${DOMAIN_NAME}`);
const canonical = new URL('/en/', site).toString();
const ogImage = new URL('/images/og-cover.png', site).toString();
const ogImageAlt = `${ATTRACTION_FULL_NAME} — ${CITY_NAME}, ${COUNTRY_NAME}`;

// Weather & air quality for the gate — values are read server side and then
// refreshed in the visitor’s browser (see WeatherRefresh.astro).
const { weather, airQuality, advice: weatherAdvice } = await loadWeather('en');

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${canonical}#attraction`,
  name: ATTRACTION_FULL_NAME,
  inLanguage: 'en',
  alternateName: [
    ATTRACTION_SHORT_NAME,
    'Dehli Gate',
    `${ATTRACTION_SHORT_NAME} ${CITY_NAME}`,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: canonical,
  image: [ogImage, heroImageAbsolute],
  isAccessibleForFree: true,
  publicAccess: true,
  isPartOf: { '@type': 'TouristAttraction', name: 'Walled City of Lahore', url: WIKIPEDIA_URL },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'H8JG+PHM, Inside Delhi Gate, Akbari Mandi, Walled City of Lahore',
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL, WIKIPEDIA_URL, WIKIMEDIA_CATEGORY_URL],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '00:00', closes: '23:59' }
  ]
  // NOTE: aggregateRating / review intentionally omitted — review data is
  // third-party Google Maps content and stays in the visible page only.
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION_FULL_NAME, item: canonical },
    { '@type': 'ListItem', position: 2, name: CITY_NAME, item: 'https://en.wikipedia.org/wiki/Lahore' },
    { '@type': 'ListItem', position: 3, name: STATE_PROVINCE, item: 'https://en.wikipedia.org/wiki/Punjab,_Pakistan' },
    { '@type': 'ListItem', position: 4, name: COUNTRY_NAME, item: 'https://en.wikipedia.org/wiki/Pakistan' }
  ]
};

const faq = [
  [`Where is ${ATTRACTION_FULL_NAME} located?`, `${ATTRACTION_SHORT_NAME} stands on the eastern side of the Walled City of ${CITY_NAME}, near Akbari Mandi, in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}. Address: H8JG+PHM, Inside Delhi Gate, Akbari Mandi, Walled City of ${CITY_NAME}, ${CITY_NAME} ${POSTAL_CODE}, ${COUNTRY_NAME}; coordinates ${LATITUDE}, ${LONGITUDE}.`],
  [`How much does it cost to see ${ATTRACTION_SHORT_NAME}?`, 'Walking through the historic gate and the bazaar passage is generally free of charge. Separate tickets may apply for Shahi Hammam, special guided walks or curated tours — check the latest Walled City of Lahore Authority information before you set out.'],
  ['How much time should I allow?', 'Twenty to forty minutes is enough for the gate alone, but two to three hours is more realistic once you include the Shahi Hammam, Wazir Khan Mosque and the restored Royal Trail.'],
  ['What time of day is best?', 'Mornings give softer light and thinner crowds. Evenings feel livelier in the bazaar, but traffic and pedestrian density increase.'],
  ['Where can I park?', 'Driving inside the gate is impractical. Use legal roadside parking or a paid lot around Circular Road, then walk or take a rickshaw for the last stretch.'],
  [`Which landmarks are close to ${ATTRACTION_SHORT_NAME}?`, `Inside the gate, ${NEARBY_LANDMARK_1} is roughly 200 metres along the Royal Trail and ${NEARBY_LANDMARK_2} is a few steps away. Gali Surjan Singh, Chowk Wazir Khan, Akbari Mandi, Lahore Fort and Badshahi Mosque are all part of the same historic city.`],
  ['Is it suitable for families?', 'Yes. This is a living bazaar quarter: hold children’s hands in busy lanes, wear comfortable shoes, and dress respectfully at religious sites.'],
  [`What is the easiest way to reach ${ATTRACTION_SHORT_NAME} from the airport?`, 'A taxi or a local ride-hailing service to Delhi Gate on Circular Road is the simplest option; the drive normally takes around 30–60 minutes depending on traffic.'],
  [`What is the best time of year to visit ${ATTRACTION_SHORT_NAME}?`, 'February to April and October offer the most balanced conditions — moderate temperatures, little rain and clear light. May to June brings extreme heat, July to September heavy monsoon showers, and December to January fog and poor air quality.'],
  ['Are there toilets, parking and ATMs nearby?', 'Yes, though basic. Washrooms are available at larger heritage sites and mosque complexes, parking is found along Circular Road just outside the gate, and ATMs sit on the main roads and in larger markets. Carry cash for small purchases.']
];
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer', text:a} }))
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{ATTRACTION_FULL_NAME} | Visitor Guide, Location &amp; What to Expect</title>
  <meta name="description" content={`${ATTRACTION_FULL_NAME} — the historic Mughal gate of the Walled City of ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}. Location, map, opening details, nearby landmarks, transport, itineraries and trip tips.`} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />

  <!-- Language versions -->
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="ur" href={new URL('/', site).toString()} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', site).toString()} />

  <!-- Local / geo meta -->
  <meta name="geo.region" content={`${COUNTRY_CODE_2LETTER}-PB`} />
  <meta name="geo.placename" content={CITY_NAME} />
  <meta name="geo.position" content={`${LATITUDE};${LONGITUDE}`} />
  <meta name="ICBM" content={`${LATITUDE}, ${LONGITUDE}`} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={`${ATTRACTION_SHORT_NAME} — ${DOMAIN_NAME}`} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ur_PK" />
  <meta property="og:title" content={`${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta property="og:description" content={`Official visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${ATTRACTION_FULL_NAME} Travel Guide`} />
  <meta name="twitter:description" content={`${ATTRACTION_FULL_NAME}, ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} — location, map, opening details and nearby landmarks.`} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- PWA -->
  <meta name="theme-color" content="#5e241e" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content={ATTRACTION_FULL_NAME} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={ATTRACTION_SHORT_NAME} />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

  <!-- Structured data: attraction entity, breadcrumb hierarchy, FAQ -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
</head>
<body>
  <header class="hero tile-border">
    <div class="container hero-content">
      <div class="eyebrow">Walled City · Royal Trail</div>
      <h1>{ATTRACTION_FULL_NAME} Visitor Guide</h1>
      <p><strong>{ATTRACTION_FULL_NAME}</strong> — usually called simply <strong>{ATTRACTION_SHORT_NAME}</strong> — stands at the heart of <strong>{CITY_NAME}</strong>, <strong>{STATE_PROVINCE}</strong>, <strong>{COUNTRY_NAME}</strong>. It is the main eastern gate of the Walled City of {CITY_NAME} and the natural starting point for anyone exploring the old quarter.</p>
      <p>Beyond this high brick threshold begins the old city, where bazaars, narrow lanes, a royal bathhouse, a great mosque and everyday life all fold into a single historic streetscape.</p>
      <div class="pills">
        <a class="pill" href="#reviews" title="See reviews on Google Maps">★ {RATING_VALUE} · {RATING_COUNT} reviews</a>
        <span class="pill">{REVIEW_CATEGORY_EN}</span>
        <span class="pill">Passage open 24 hours</span>
        <span class="pill">About 2–3 hours for the full walk</span>
        <span class="pill">{LATITUDE}, {LONGITUDE}</span>
      </div>
    </div>
  </header>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container breadcrumb-inner">
      <ol>
        <li><a href="/en/">{ATTRACTION_FULL_NAME}</a></li>
        <li><a href="#story">{CITY_NAME}</a></li>
        <li><a href="#visit">{STATE_PROVINCE}</a></li>
        <li aria-current="page">{COUNTRY_NAME}</li>
      </ol>
      <span class="breadcrumb-path">{ATTRACTION_FULL_NAME} → {CITY_NAME} → {STATE_PROVINCE} → {COUNTRY_NAME}</span>
    </div>
  </nav>

  <nav class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><img src="/icons/logo.svg" alt={`${ATTRACTION_FULL_NAME} logo`} />{ATTRACTION_SHORT_NAME}</a>
      <a href="#story">Overview</a><a href="#visit">Visitor guide</a><a href="#weather">Weather</a><a href="#seasons">Seasons</a><a href="#transport">Getting here</a><a href="#services">Facilities</a><a href="#history">History</a><a href="#nearby">Nearby</a><a href="#routes">Itineraries</a><a href="#food">Food</a><a href="#responsibility">Responsibility</a><a href="#reviews">Reviews</a><a href="#map">Map</a><a href="#faq">FAQ</a><a href="#sources">Sources</a>
      <a class="lang-switch" href="/" hreflang="ur" lang="ur" dir="rtl">اردو</a>
    </div>
  </nav>

  <main id="top">
    <section id="story">
      <div class="container grid grid-2" style="align-items:center">
        <div>
          <div class="section-kicker">One gate, a whole city</div>
          <h2>About {ATTRACTION_FULL_NAME}</h2>
          <p class="lede">{ATTRACTION_SHORT_NAME} is one of the surviving gates of the Walled City of {CITY_NAME}. It stands on the eastern side, on the route that once linked Lahore Fort with the imperial road towards Delhi. Today the Royal Trail running inside it still carries intense city life, from bazaars and workshops to the Shahi Hammam and {NEARBY_LANDMARK_1}.</p>
          <p>Looking for the most famous historic threshold of old {CITY_NAME}? This is where the old city begins: step inside and narrow lanes, brick arches and tile-work patterns turn into one continuous experience.</p>
          <p>From {ATTRACTION_FULL_NAME} you can comfortably reach the surrounding historic sites on foot, above all <strong>{NEARBY_LANDMARK_1}</strong> and <strong>{NEARBY_LANDMARK_2}</strong>.</p>
          <div class="card"><strong>What to notice:</strong> the brick arch of the gate, the inner bazaar, the royal bathhouse, Sabil Lane, Gali Surjan Singh, Chowk Wazir Khan and {NEARBY_LANDMARK_1}.</div>
        </div>
        <div class="photo-card arch">
          <img src="https://upload.wikimedia.org/wikipedia/commons/2/28/Wazir_khan_mosque_entry.jpg" alt={`${NEARBY_LANDMARK_1} — courtyard of the famous Mughal mosque near ${ATTRACTION_SHORT_NAME}, ${CITY_NAME}`} loading="lazy" width="1200" height="900" />
          <div class="caption">Wazir Khan Mosque — photo: Shahbaz Aslam, CC BY-SA 4.0</div>
        </div>
      </div>
    </section>

    <section id="visit" style="background:#f0d9b522">
      <div class="container">
        <div class="section-kicker">Before you go</div><h2>Practical Visitor Guide for {ATTRACTION_SHORT_NAME}</h2>
        <div class="grid grid-3">
          <article class="card"><h3>🎟️ Tickets / fees</h3><p>There is no separate admission ticket for walking through {ATTRACTION_SHORT_NAME}. Different rates may apply for Walled City of Lahore Authority guided walks, special events or access to restored interiors.</p></article>
          <article class="card"><h3>🕰️ Best time of day</h3><p>08:00–10:00 is best for photography, light crowd levels and soft morning light. Evenings are livelier in the bazaar, but traffic also builds up.</p></article>
          <article class="card"><h3>⏳ How long to stay</h3><p>Allow 20–40 minutes for the gate alone, and roughly 2–3 hours if you walk on to the royal bathhouse and the mosque.</p></article>
          <article class="card"><h3>🚗 Parking</h3><p>The lanes of the old city are narrow. Legal parking or a drop-off around Circular Road works better; finish the last part on foot or by rickshaw.</p></article>
          <article class="card"><h3>👟 What to carry</h3><p>Comfortable shoes, water, a hat in summer and modest dress for mosques. Keep an eye on phones and wallets in crowds.</p></article>
          <article class="card"><h3>📷 Photography</h3><p>Respect people’s privacy in ordinary street photography. Commercial shoots may need permits and fees from the Walled City of Lahore Authority.</p></article>
        </div>
      </div>
    </section>

    <section id="weather" style="background:#eef3f7">
      <div class="container">
        <div class="section-kicker">Weather &amp; forecast</div>
        <h2>Today’s weather and the 7-day forecast at {ATTRACTION_SHORT_NAME}, {CITY_NAME}</h2>
        {weather ? (
          <div class="wx-wrap">
            <article class="wx-now">
              <div class="wx-now-head">
                <span class="wx-glyph" id="wx-glyph">{describeWeather(weather.code, 'en')[1]}</span>
                <span class="wx-temp"><strong id="wx-temp">{weather.temperature}</strong>°</span>
                <span class="wx-unit">°C · {CITY_NAME}</span>
              </div>
              <p class="wx-now-desc" id="wx-desc">{describeWeather(weather.code, 'en')[0]}</p>
              <ul class="wx-metrics">
                <li><span>Feels like</span><strong><span id="wx-feels">{weather.apparent}</span>°</strong></li>
                <li><span>Humidity</span><strong><span id="wx-hum">{weather.humidity}</span>%</strong></li>
                <li><span>Wind speed</span><strong><span id="wx-wind">{weather.wind}</span> km/h</strong></li>
                <li><span>Rain in last hour</span><strong><span id="wx-precip">{weather.precipitation ?? 0}</span> mm</strong></li>
              </ul>
              <p class="wx-clock" id="wx-clock">Updated: {(weather.observedAt ?? '').replace('T', ' · ')}</p>
            </article>
            <div class="wx-side">
              <div class="wx-advice">
                <h3>Today’s advice</h3>
                <p id="wx-advice">{weatherAdvice}</p>
              </div>
              {airQuality ? (
                <div class={`wx-air wx-air-${airQuality.levelKey ?? 'unknown'}`}>
                  <h3>Air quality</h3>
                  <p class="wx-air-aqi">Index <strong id="wx-aqi">{airQuality.aqi}</strong> · <span id="wx-aqi-label">{airQuality.level}</span></p>
                  <p class="wx-air-pm">Fine particles (PM2.5): <strong id="wx-pm25">{airQuality.pm25}</strong> · coarse particles (PM10): <strong id="wx-pm10">{airQuality.pm10}</strong></p>
                </div>
              ) : (
                <div class="wx-air">
                  <h3>Air quality</h3>
                  <p>Fresh air-quality data is not available at the moment.</p>
                </div>
              )}
            </div>
          </div>
          <ul class="wx-days">
            {weather.days.map((day, index) => (
              <li class="wx-day" data-day={String(index)}>
                <span class="wx-day-name">{day.label}</span>
                <span class="wx-day-glyph" data-glyph>{describeWeather(day.code, 'en')[1]}</span>
                <span class="wx-day-desc" data-desc>{describeWeather(day.code, 'en')[0]}</span>
                <span class="wx-day-temps"><strong data-max>{day.max}</strong>° / <span data-min>{day.min}</span>°</span>
                <span class="wx-day-rain">Chance of rain <strong data-pop>{day.rainChance}</strong>%</span>
              </li>
            ))}
          </ul>
          <p class="credit">Weather figures are citywide; inside the narrow lanes of the old city, sun exposure, wind and felt temperature can differ noticeably. For long-term averages, consult the national meteorological service.</p>
        ) : (
          <p class="lede">Weather details are unavailable right now. Before you set off, check the latest forecast from the national meteorological service so you can plan around rain, heat or fog.</p>
        )}
      </div>
    </section>

    <section id="seasons" style="background:#f7efe3">
      <div class="container">
        <div class="section-kicker">Seasonal planning</div>
        <h2>When to visit {ATTRACTION_SHORT_NAME} (Seasonal Strategy)</h2>
        <p class="lede">{CITY_NAME} has a continental climate: a long, intense summer, a short but humid monsoon, and winters marked by fog and polluted air. A visit here is essentially a walking experience, so temperature, rainfall and air quality all shape how pleasant that walk will be.</p>
        <div class="table-wrap">
          <table class="data-table">
            <caption>Quarterly guidance for {ATTRACTION_FULL_NAME} in {CITY_NAME}</caption>
            <thead>
              <tr>
                <th scope="col">Quarter</th>
                <th scope="col">Weather &amp; temperature</th>
                <th scope="col">Rain &amp; air quality</th>
                <th scope="col">Crowds &amp; light</th>
                <th scope="col">What to pack</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">February to April<br /><span class="cell-note">Spring, the best window</span></th>
                <td>Daytime usually 22–32 °C, mild and pleasant evenings</td>
                <td>Little rain, occasional showers; air quality generally acceptable</td>
                <td>Higher visitor numbers, soft morning light ideal for photography</td>
                <td>Light cotton clothing, hat, water, sunglasses</td>
              </tr>
              <tr>
                <th scope="row">May to June<br /><span class="cell-note">Extreme heat</span></th>
                <td>Daytime highs usually 38–45 °C with fierce sun</td>
                <td>Dry conditions, dust haze and occasional dust storms</td>
                <td>Lanes relatively empty at midday; light is harsh and shadows are hard</td>
                <td>Extra water, salts/electrolytes, umbrella, plan to go out before dawn or after sunset</td>
              </tr>
              <tr>
                <th scope="row">July to September<br /><span class="cell-note">Monsoon</span></th>
                <td>30–38 °C with high humidity, so you tire quickly from sweating</td>
                <td>Heavy but short downpours and thunderstorms; standing water in the lanes is common</td>
                <td>Thinner crowds, softer and more dramatic cloud-filtered light</td>
                <td>Umbrella or raincoat, non-slip shoes, quick-drying clothing</td>
              </tr>
              <tr>
                <th scope="row">October to January<br /><span class="cell-note">Autumn, fog and smog</span></th>
                <td>October 25–32 °C; December–January days 15–22 °C and mornings 4–8 °C</td>
                <td>December–January brings dense fog and the city’s smog peak, with reduced visibility and possible cough or breathing discomfort</td>
                <td>Winter mornings are usually hidden in fog; midday light is the best of the day</td>
                <td>Light warm layered jacket, an N95-style mask, and move the morning walk to midday</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="grid grid-3">
          <article class="card">
            <h3>🌡️ Climatological analysis</h3>
            <p>On long-term climatological averages, the hottest period in {CITY_NAME} falls in May–June and the coldest in December–January, while most of the annual rainfall arrives with the monsoon (July–September). February–April and October offer the best balance for walking.</p>
          </article>
          <article class="card">
            <h3>🌫️ Air quality and smog</h3>
            <p>In winter, still air and a temperature inversion trap fog and polluted particles over the city, pushing PM2.5 sharply upward. Sensitive visitors — children, older travellers, people with asthma or heart conditions — should wear a mask on those days and check the air-quality index shown above.</p>
          </article>
          <article class="card">
            <h3>🏙️ Urban environment and the lanes</h3>
            <p>The lanes of the old city are narrow and built of brick, so in summer they can bake like an oven at midday, while in winter low air movement lets smoke and fog settle. After rain, limited drainage leaves standing water in some lanes — so keep an eye on local conditions and air quality in every season.</p>
          </article>
        </div>
        <p class="credit">Summary: for the most comfortable experience choose February–April or October. In summer go out between 07:00 and 10:00, in winter between 12:00 and 15:00. During Ramadan and local festivals, bazaar hours and crowd patterns change, so plan your timing in advance.</p>
      </div>
    </section>

    <section id="transport">
      <div class="container grid grid-2">
        <div>
          <div class="section-kicker">Location &amp; transport</div><h2>Getting here</h2>
          <p class="lede">Narrow lanes make every last few minutes the busiest. The route below is the one most visitors take.</p>
          <div class="route">
            <div class="step"><h4>Ring road approach</h4><p>Arrive at the {CITY_NAME} ring road ({ATTRACTION_SHORT_NAME}, Circular Road).</p></div>
            <div class="step"><h4>Car drop-off or legal roadside lot</h4><p>Ten minutes’ walk (about 750 m) along Circular Road to the {ATTRACTION_SHORT_NAME} drop-off.</p></div>
            <div class="step"><h4>Rickshaw through the bazaar</h4><p>Or stop outside {ATTRACTION_SHORT_NAME} and walk the final 300 m through the bazaar.</p></div>
          </div>
          <div class="small-cta"><a class="btn ghost" href="#map">Jump to the map</a></div>
        </div>
        <div class="aside-card"><h3>Nearby anchors</h3><div class="facts">
          <div><span>Mughal-era mosque</span><strong>{NEARBY_LANDMARK_1} — about 200 m</strong></div>
          <div><span>Mughal bathhouse</span><strong>{NEARBY_LANDMARK_2} — about 150 m</strong></div>
          <div><span>Largest fort</span><strong>Lahore Fort — 12-minute rickshaw ride</strong></div>
        </div></div>
      </div>

      <div class="container" style="margin-top:2.2rem">
        <h3>Getting here in detail: reaching {ATTRACTION_SHORT_NAME} by every mode</h3>
        <p class="lede">The general route, typical timing and practical notes for each travel mode are set out below. Actual times vary with traffic, weather and time of day, so check your route on the map before leaving.</p>
        <div class="grid grid-3">
