---
import '../../styles/global.css';
import WeatherPanel from '../../components/WeatherPanel.astro';
import TopicLinks from '../../components/TopicLinks.astro';
import * as attraction from '../../data/attraction';

const {
  ATTRACTION_FULL_NAME,
  ATTRACTION_SHORT_NAME,
  CITY_NAME,
  COUNTRY_CODE_2LETTER,
  COUNTRY_NAME,
  DOMAIN_NAME,
  GOVT_TOURISM_URL,
  LATITUDE,
  LONGITUDE,
  MAPS_DIRECTIONS_URL,
  MAPS_EMBED_SRC,
  MAPS_SHARE_URL,
  MET_OFFICE_URL,
  NEARBY_LANDMARK_1,
  NEARBY_LANDMARK_2,
  POSTAL_CODE,
  RATING_COUNT,
  RATING_VALUE,
  REVIEW_CATEGORY_EN,
  REVIEW_SYNC_EN,
  STATE_PROVINCE,
  WIKIPEDIA_URL
} = attraction;


const site = Astro.site ?? new URL(`https://${DOMAIN_NAME}`);
const canonical = new URL('/en/', site).toString();
const ogImage = new URL('/images/og-cover.png', site).toString();
const ogImageAlt = `${ATTRACTION_FULL_NAME} — ${CITY_NAME}, ${COUNTRY_NAME}`;

// Weather estimates are requested only in the browser by WeatherPanel.


const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'HistoricalLandmark'],
  '@id': `https://${DOMAIN_NAME}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  inLanguage: 'en',
  alternateName: [
    ATTRACTION_SHORT_NAME,
    'Dehli Gate',
    `${ATTRACTION_SHORT_NAME} ${CITY_NAME}`,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: canonical,
  image: [ogImage],
  isPartOf: { '@type': 'TouristAttraction', name: 'Walled City of Lahore' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, 'https://doam.gov.pk/public/sites/6449', WIKIPEDIA_URL]
  // NOTE: aggregateRating / review intentionally omitted — review data is
  // third-party Google Maps content and stays in the visible page only.
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ATTRACTION_FULL_NAME, item: canonical },
    { '@type': 'ListItem', position: 2, name: CITY_NAME, item: 'https://en.wikipedia.org/wiki/Lahore' },
    { '@type': 'ListItem', position: 3, name: STATE_PROVINCE, item: 'https://en.wikipedia.org/wiki/Punjab,_Pakistan' },
    { '@type': 'ListItem', position: 4, name: COUNTRY_NAME, item: 'https://en.wikipedia.org/wiki/Pakistan' }
  ]
};

const faq = [
  [`Where is ${ATTRACTION_FULL_NAME} located?`, `${ATTRACTION_SHORT_NAME} stands on the eastern side of the Walled City of ${CITY_NAME}, near Akbari Mandi, in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}. Address: H8JG+PHM, Inside Delhi Gate, Akbari Mandi, Walled City of ${CITY_NAME}, ${CITY_NAME} ${POSTAL_CODE}, ${COUNTRY_NAME}; coordinates ${LATITUDE}, ${LONGITUDE}.`],
  [`How much does it cost to see ${ATTRACTION_SHORT_NAME}?`, 'A current operator-confirmed fee for the passage has not been found. Shahi Hammam admission and WCLA tours are separate; check their current charges and booking terms.'],
  ['How much time should I allow?', 'Rough planning estimates only: allow 20–40 minutes around the gate, or 2–3 hours for a wider visit if the separate sites confirm access. Queues, crowds, prayer, closures and your route can change the time needed.'],
  ['What time of day is best?', 'Plan a daylight visit after checking access and the forecast. No night-time safety assessment has been verified.'],
  ['What are the opening hours of Delhi Gate?', 'Google Maps lists the public passage as open 24 hours (29 October 2026); the operator has not confirmed current access hours or admission terms. This does not establish night-time safety or access to Shahi Hammam, Wazir Khan Mosque or paid walks. Confirm each facility and any tour booking separately with WCLA before travel.'],
  ['Where can I park?', 'Ask your driver or the local authority to confirm a legal drop-off and parking option for your date. No parking location, availability, price or access route has been verified here.'],
  [`Which landmarks are close to ${ATTRACTION_SHORT_NAME}?`, `Inside the gate, ${NEARBY_LANDMARK_1} is roughly 200 metres along the Royal Trail and ${NEARBY_LANDMARK_2} is a few steps away. Gali Surjan Singh, Chowk Wazir Khan, Akbari Mandi, Lahore Fort and Badshahi Mosque are all part of the same historic city.`],
  ['Is it suitable for families?', 'Busy lanes may be uneven and crowded. Check the route and facilities beforehand; the map entrance marker does not certify end-to-end accessibility.'],
  [`What is the easiest way to reach ${ATTRACTION_SHORT_NAME} from the airport?`, 'Ask a licensed taxi or local transport operator for current options and a legal Circular Road drop-off. No airport travel time or timetable is verified here.'],
  [`What is the best time of year to visit ${ATTRACTION_SHORT_NAME}?`, 'Choose your date using the current forecast, air-quality warnings and local access notices. This guide has not verified a Lahore climate-normal dataset, so no month is guaranteed to offer mild weather or clear air.'],
  ['Are there toilets, parking and ATMs nearby?', 'Toilets, parking and ATMs are not verified on site. Ask the relevant facility about availability and step-free access before travel.']
];
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer', text:a} }))
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Delhi Gate Lahore – Location, Opening Hours, History &amp; Visitor Guide</title>
  <meta name="description" content="Explore Delhi Gate in Lahore's Walled City. Find its location, visiting hours, parking advice, history, and walking routes to Shahi Hammam and Wazir Khan Mosque." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />

  <!-- Language versions -->
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="ur" href={new URL('/', site).toString()} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', site).toString()} />

  <!-- Local / geo meta -->
  <meta name="geo.region" content={`${COUNTRY_CODE_2LETTER}-PB`} />
  <meta name="geo.placename" content={CITY_NAME} />
  <meta name="geo.position" content={`${LATITUDE};${LONGITUDE}`} />
  <meta name="ICBM" content={`${LATITUDE}, ${LONGITUDE}`} />

  <!-- Open Graph -->
  <meta property="og:site_name" content={`${ATTRACTION_SHORT_NAME} — ${DOMAIN_NAME}`} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="ur_PK" />
  <meta property="og:title" content="Delhi Gate Lahore – Location, Opening Hours, History & Visitor Guide" />
  <meta property="og:description" content="Explore Delhi Gate in Lahore's Walled City. Find its location, visiting hours, parking advice, history, and walking routes to Shahi Hammam and Wazir Khan Mosque." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Delhi Gate Lahore – Location, Opening Hours, History & Visitor Guide" />
  <meta name="twitter:description" content="Explore Delhi Gate in Lahore's Walled City. Find its location, visiting hours, parking advice, history, and walking routes to Shahi Hammam and Wazir Khan Mosque." />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- PWA -->
  <meta name="theme-color" content="#5e241e" />
  <meta name="color-scheme" content="light" />
  <meta name="application-name" content={ATTRACTION_FULL_NAME} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={ATTRACTION_SHORT_NAME} />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />

  <!-- Structured data: attraction entity, breadcrumb hierarchy, FAQ -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
</head>
<body>
  <header class="hero tile-border">
    <div class="container hero-content">
      <div class="eyebrow">Walled City · Royal Trail</div>
      <h1>Delhi Gate Lahore</h1>
      <p class="hero-name"><bdi dir="rtl" lang="ur">دہلی دروازہ</bdi> · Historic Gateway to Lahore's Walled City and Royal Trail</p>
      <p><strong>{ATTRACTION_FULL_NAME}</strong> — usually called simply <strong>{ATTRACTION_SHORT_NAME}</strong> — stands at the heart of <strong>{CITY_NAME}</strong>, <strong>{STATE_PROVINCE}</strong>, <strong>{COUNTRY_NAME}</strong>. It is the main eastern gate of the Walled City of {CITY_NAME} and the natural starting point for anyone exploring the old quarter.</p>
      <p>Beyond this high brick threshold begins the old city, where bazaars, narrow lanes, a royal bathhouse, a great mosque and everyday life all fold into a single historic streetscape.</p>
      <div class="pills"><span class="pill">Real photograph of Delhi Gate passage</span>
        <a class="pill" href="#reviews" title="See reviews on Google Maps">★ {RATING_VALUE} · {RATING_COUNT} reviews</a>
        <span class="pill">{REVIEW_CATEGORY_EN}</span>
        <span class="pill">Public passage — confirm access</span>
        <span class="pill">About Rough itinerary estimate</span>
        <span class="pill">{LATITUDE}, {LONGITUDE}</span>
      </div>
    </div>
  </header>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container breadcrumb-inner">
      <ol>
        <li><a href="/en/">{ATTRACTION_FULL_NAME}</a></li>
        <li><a href="#story">{CITY_NAME}</a></li>
        <li><a href="#visit">{STATE_PROVINCE}</a></li>
        <li aria-current="page">{COUNTRY_NAME}</li>
      </ol>
      <span class="breadcrumb-path">{ATTRACTION_FULL_NAME} → {CITY_NAME} → {STATE_PROVINCE} → {COUNTRY_NAME}</span>
    </div>
  </nav>

  <nav class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#top"><img src="/icons/logo.svg" alt={`${ATTRACTION_FULL_NAME} logo`} />{ATTRACTION_SHORT_NAME}</a>
      <a href="#story">Overview</a><a href="#visit">Visitor guide</a><a href="#weather">Weather</a><a href="#seasons">Seasons</a><a href="#transport">Getting here</a><a href="#services">Facilities</a><a href="#history">History</a><a href="#nearby">Nearby</a><a href="#routes">Itineraries</a><a href="#food">Food</a><a href="#responsibility">Responsibility</a><a href="#reviews">Reviews</a><a href="#map">Map</a><a href="#faq">FAQ</a><a href="#guides">Guides</a><a href="#sources">Sources</a>
      <a class="lang-switch" href="/" hreflang="ur" lang="ur" dir="rtl">اردو</a>
    </div>
  </nav>

  <main id="top">
    <section id="story">
      <div class="container grid grid-2" style="align-items:center">
        <div>
          <div class="section-kicker">One gate, a whole city</div>
          <h2>About {ATTRACTION_FULL_NAME}</h2>
          <p class="lede">Delhi Gate is a historic eastern entrance in Lahore’s fortification, named for its orientation towards Delhi. The government heritage record places Wazir Khan Mosque inside the gate nearby. Royal Trail and restoration history do not confirm present-day access; check each facility separately.</p>
          <p>Looking for the most famous historic threshold of old {CITY_NAME}? This is where the old city begins: step inside and narrow lanes, brick arches and tile-work patterns turn into one continuous experience.</p>
          <p>Nearby places to investigate from {ATTRACTION_FULL_NAME} include <strong>{NEARBY_LANDMARK_1}</strong> and <strong>{NEARBY_LANDMARK_2}</strong>.</p>
          <div class="card"><strong>What to notice:</strong> the brick arch of the gate, the inner bazaar, the royal bathhouse, Sabil Lane, Gali Surjan Singh, Chowk Wazir Khan and {NEARBY_LANDMARK_1}.</div>
        </div>
        <div style="display:grid;gap:1rem">
          <div class="photo-card arch" style="min-height:320px">
            <img src="/images/delhi-gate-lahore.jpg" alt="Real photograph of the illuminated passage inside Delhi Gate, Lahore" loading="lazy" width="1860" height="1240" />
            <div class="caption">Delhi Gate passage — photo: Mubeenakram, CC BY-SA 4.0</div>
          </div>
          <div class="photo-card arch" style="min-height:320px">
            <img src="/images/wazir-entry.jpg" alt="Historic Wazir Khan Mosque seen through its entrance, 2016" loading="lazy" width="1280" height="1264" />
            <div class="caption">Wazir Khan Mosque — photo: Shahbaz Aslam, CC BY-SA 4.0</div>
          </div>
        </div>
      </div>
    </section>

    <section id="visit" style="background:#f0d9b522"><div class="container"><p class="card">Maps hours concern the public passage only; confirm current access and each building’s hours separately.</p></div>
      <div class="container">
        <div class="section-kicker">Before you go</div><h2>Practical Visitor Guide for {ATTRACTION_SHORT_NAME}</h2>
        <div class="grid grid-3">
          <article class="card"><h3>🎟️ Tickets / fees</h3><p>Current passage admission terms have not been confirmed by the operator. Different rates may apply for Walled City of Lahore Authority guided walks, special events or access to restored interiors.</p></article>
          <article class="card"><h3>🕰️ Best time of day</h3><p>Plan a daylight visit after confirming access and checking weather and local notices. Crowds and traffic vary.</p></article>
          <article class="card"><h3>⏳ How long to stay</h3><p>Rough planning estimates: 20–40 minutes around the gate or 2–3 hours for a wider visit, subject to separate facility access, queues, prayer, closures and your route.</p></article>
          <article class="card"><h3>🚗 Parking</h3><p>Ask your driver or the local authority about legal drop-off and parking arrangements. Locations, availability and the onward route have not been verified here.</p></article>
          <article class="card"><h3>👟 What to carry</h3><p>Comfortable shoes, water, a hat in summer and modest dress for mosques. Keep an eye on phones and wallets in crowds.</p></article>
          <article class="card"><h3>📷 Photography</h3><p>Respect people’s privacy in ordinary street photography. Commercial shoots may need permits and fees from the Walled City of Lahore Authority.</p></article>
        </div>
      </div>
    </section>

    <WeatherPanel lang="en" />

    <section id="seasons"><div class="container"><h2>Seasonal planning</h2><p class="lede">Check the Pakistan Meteorological Department forecast and air-quality warnings for your actual date. Heat, monsoon rain and winter fog can affect a visit. These are planning considerations, not sourced monthly averages or a guarantee of clear conditions. Choose a daylight visit after checking local access; weather alone does not establish a safe route.</p></div></section>

    <section id="transport"><div class="container"><h2>Getting to Delhi Gate</h2><p class="lede">Use the map pin for the eastern gate near Akbari Mandi. Ask your driver about a legal drop-off on Circular Road and current restrictions; Circular Road is not Lahore Ring Road. No airport journey time, parking place or public-transport timetable is confirmed here. Check the current route and last connection with the relevant operator. The last stretch may involve busy, uneven lanes.</p></div></section>

    <section id="services"><div class="container"><h2>Facilities and accessibility checks</h2><p class="lede">Toilets, step-free access, parking and ATMs have not been verified on site. Maps marks an accessible entrance, which does not confirm the whole route, surfaces, ramps or nearby interiors. Contact each facility about toilets, thresholds, assistance and opening before setting out; arrange an alternative if access cannot be confirmed.</p></div></section>

    <section id="history"><div class="container"><div class="section-kicker">History and architecture</div><h2>What the official heritage record establishes</h2><div class="grid grid-2"><article class="card"><h3>Historic identity</h3><p>The Department of Archaeology and Museums records Delhi Gate in Lahore’s eastern fortification, facing Delhi, with Wazir Khan Mosque in its vicinity. It lists Punjab government ownership and protection under the Antiquities Act 1975, amended 1992.</p><p>The record gives the broad relative chronology 1526–1857 CE. That range is not a verified construction date for every part of the surviving structure; this guide does not assign particular timber, paintwork or repairs to a specific period.</p></article><article class="card"><h3>Gate, bazaar and Royal Trail context</h3><p>WCLA places the mosque about 200 metres inside the gate and Shahi Hammam nearby. The gate is a historic entrance within a working urban district, not evidence that every nearby interior shares one admission system.</p><p>Historical restoration and Royal Trail descriptions are not current opening notices. Confirm access, any barriers, facility hours and tour bookings separately before travel.</p><p><a href="https://doam.gov.pk/public/sites/6449">DOAM — Delhi Gate</a> · <a href={GOVT_TOURISM_URL}>WCLA — Gates</a></p></article></div></div></section>

    <section id="nearby" style="background:#fff9ef">
      <div class="container"><div class="section-kicker">Explore on foot</div><h2>Landmarks &amp; Attractions around {ATTRACTION_SHORT_NAME}</h2>
        <p class="lede">While visiting {ATTRACTION_FULL_NAME}, travellers can easily take in the surrounding historic sites and points of interest, above all <strong>{NEARBY_LANDMARK_1}</strong> and <strong>{NEARBY_LANDMARK_2}</strong>. All of them lie within walking distance inside the same walled city.</p>
        <div class="grid grid-3">
          <article class="card"><h3>Shahi Hammam</h3><p>A few steps inside {ATTRACTION_SHORT_NAME}. A historic Mughal public bathhouse, showing traces of frescoes and the underfloor heating system.</p></article>
          <article class="card"><h3>Wazir Khan Mosque</h3><p>About 200 m in along the Royal Trail. Lahore’s outstanding Mughal mosque for its tilework, calligraphy and coloured ornament.</p></article>
          <article class="card"><h3>Gali Surjan Singh</h3><p>A restored historic lane that reveals the fine-grained urban fabric of inner Lahore through timber balconies and its traditional residential character.</p></article>
          <article class="card"><h3>Chowk Wazir Khan</h3><p>The historic square in front of the mosque, framed by craft bazaars, havelis and old trading routes.</p></article>
          <article class="card"><h3>Akbari Mandi</h3><p>An old wholesale market near the gate whose trade in spices and grain shaped the identity of the whole quarter.</p></article>
          <article class="card"><h3>Lahore Fort &amp; Badshahi Mosque</h3><p>At the western end of the same historic city: the natural destinations of a full Royal Trail walk, though considerably further away.</p></article>
        </div>
      </div>
    </section>

    <section id="routes"><div class="container"><h2>Itinerary ideas — check each stop</h2><p class="lede">Start with the gate exterior, then consider Shahi Hammam and Wazir Khan Mosque separately if their operators confirm access. WCLA describes the mosque about 200 metres inside the gate; this is orientation, not a verified accessible walking route. Allow flexible time for queues, prayer, closures and traffic. A WCLA organised evening walk is a separately booked activity, not evidence of unrestricted night access.</p></div></section>

    <section id="food">
      <div class="container">
        <div class="section-kicker">Lahori flavours</div><h2>What to eat nearby</h2>
        <div class="grid grid-3">
          <article class="card"><h3>Traditional breakfast</h3><p>In the old city, halwa puri, chickpeas, naan and lassi are everyday choices. A breakfast stop pairs perfectly with a morning walk.</p></article>
          <article class="card"><h3>Bazaar snacks</h3><p>Samosas, pakoras, tea and seasonal sweets are easy to find in the lanes. Prefer busy stalls serving freshly cooked items.</p></article>
          <article class="card"><h3>Fort Road food street</h3><p>If you complete the walk towards Lahore Fort, the restaurants along Fort Road are known for classic Lahori dishes and views of Badshahi Mosque.</p></article>
        </div>
        <p class="credit">Note: business hours and which stalls are open change quickly; checking on the map or by phone on the same day works best.</p>
      </div>
    </section>

    <section id="responsibility" style="background:#f7efe3">
      <div class="container">
        <div class="section-kicker">Science &amp; responsibility</div>
        <h2>Building Science &amp; Visitor Responsibility</h2>
        <p class="lede">{ATTRACTION_SHORT_NAME} and the Royal Trail are built of lime mortar and brick, whose greatest enemies are moisture, salts and vibration. Small habits matter here: touching a wall, spraying water, rubbing a surface or standing against it can damage a surface centuries old.</p>
        <div class="grid grid-2">
          <article class="card">
            <h3>🔬 Why the fabric is fragile</h3>
            <p>Lime mortar and fired brick absorb water. As moisture evaporates upwards, salts inside migrate to the surface and crystallise (salt efflorescence), so fragments of tile and plaster begin to flake off. Heavy rain or seepage weakens walls, while constant vibration or repeated touching wears down fresco and tile surfaces.</p>
            <p>Observe posted barriers and ask the relevant site staff about restrictions around frescoes and tilework. This guide has not verified a specific exclusion distance.</p>
          </article>
          <article class="card">
            <h3>✅ Practical rules for visitors</h3>
            <ul class="src-list">
              <li>Do not touch or lean against walls, frescoes or tilework.</li>
              <li>Writing on walls, carving or leaving any mark is prohibited.</li>
              <li>Do not climb or sit on historic structures; ask permission before using tripods or drones.</li>
              <li>Do not block the narrow lanes; respect the everyday routes of local residents.</li>
              <li>Use bins for litter and take your water bottles with you.</li>
              <li>Dress respectfully, keep quiet and observe prayer times at places of worship.</li>
              <li>Ask permission before photographing people, and confirm prices with shopkeepers first.</li>
              <li>Support conservation economically by buying local crafts and using local guide services.</li>
            </ul>
          </article>
        </div>
        <p class="credit">This site is an independent visitor guide: we do not recommend businesses, do not collect tickets or fees, and the instructions posted by local authorities always take priority.</p>
      </div>
    </section>

    <section id="reviews"><div class="container"><h2>Dated Google Maps snapshot</h2><p>Google Maps · {RATING_VALUE}/5 · {RATING_COUNT} reviews · {REVIEW_SYNC_EN}</p><p>Manually checked snapshot; no live synchronisation or copied review text. <a href={MAPS_SHARE_URL}>Google Maps ↗</a></p></div></section>

    <section id="map" style="background:#5e241e0c">
      <div class="container"><div class="section-kicker">Location</div><h2>Map of {ATTRACTION_SHORT_NAME} (Location Map)</h2>
        <div class="map-wrap"><iframe title={`${ATTRACTION_FULL_NAME} — map`} src={MAPS_EMBED_SRC} width="100%" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
        <p>Address: H8JG+PHM, Inside Delhi Gate, Akbari Mandi, Walled City of Lahore, {CITY_NAME} {POSTAL_CODE}, {COUNTRY_NAME} · coordinates {LATITUDE}, {LONGITUDE}</p>
        <p class="map-links">
          <a class="btn" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">View the location on Google Maps ↗</a>
          <a class="btn ghost" href={MAPS_DIRECTIONS_URL} target="_blank" rel="noopener noreferrer">Directions ↗</a>
        </p>
        <p class="credit">For official updates and regional tourism information, see <a href={GOVT_TOURISM_URL} target="_blank" rel="noopener noreferrer">{COUNTRY_NAME} / {STATE_PROVINCE} official tourism portal — Walled City of Lahore Authority (WCLA)</a>.</p>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container"><div class="section-kicker">FAQ</div><h2>Frequently Asked Questions (FAQ)</h2>
        {faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <TopicLinks locale="en" />

<section id="sources"><div class="container"><h2>Sources and image rights</h2><p>Google Maps lists the public passage as open 24 hours (29 October 2026); the operator has not confirmed current access hours or admission terms. This does not establish night-time safety or access to Shahi Hammam, Wazir Khan Mosque or paid walks. Confirm each facility and any tour booking separately with WCLA before travel.</p><ul><li><a href="https://doam.gov.pk/public/sites/6449">Department of Archaeology and Museums — Delhi Gate: history, protected status and coordinates</a></li><li><a href={GOVT_TOURISM_URL}>WCLA — Gates</a></li><li><a href="https://walledcitylahore.gop.pk/product/roshan-galliyan/">WCLA — separately booked evening walk; check dates, availability and fees</a></li><li><a href={MET_OFFICE_URL}>Pakistan Meteorological Department</a></li></ul><p>The cover shows a real photograph of Delhi Gate's passage. Delhi Gate photograph: <a href="https://commons.wikimedia.org/wiki/File:Delhi_gate_Lahore.jpg">Mubeenakram, 23 September 2018</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, original unmodified. Historical mosque photograph: <a href="https://commons.wikimedia.org/wiki/File:Wazir_khan_mosque_entry.jpg">Shahbaz Aslam; crop and colour edits by Willard84, Wazir Khan Mosque entry, 6 February 2016</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>; locally resized; Commons version includes crop/colour edits. This depicts the mosque, not the gate or hammam.</p></div></section>

    <section>
      <div class="container notice"><h2 style="font-size:2rem">A little planning goes a long way</h2><p>Delhi Gate is not a “look at the building” stop; the real experience is walking in through the gate, feeling the pace of the bazaar, seeing the royal bathhouse and carrying on to Wazir Khan Mosque. Respect the everyday routes of local residents.</p></div>
    </section>
